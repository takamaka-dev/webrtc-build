+package org.webrtc;
+
+import java.nio.ByteBuffer;
+
+import androidx.annotation.Nullable;
+import org.webrtc.AudioProcessingFactory;
+
+
+public class ExternalAudioProcessingFactory implements AudioProcessingFactory {
+
+  /**
+   * Interface for external audio processing.
+   */
+  public static interface AudioProcessing {
+    /**
+     * Called when the processor should be initialized with a new sample rate and
+     * number of channels.
+     */
+    @CalledByNative("AudioProcessing")
+    void initialize(int sampleRateHz, int numChannels);
+    /** Called when the processor should be reset with a new sample rate. */  
+    @CalledByNative("AudioProcessing")
+    void reset(int newRate);
+    /**  
+     * Processes the given capture or render signal. NOTE: `buffer.data` will be  
+     * freed once this function returns so callers who want to use the data  
+     * asynchronously must make sure to copy it first.  
+     */
+    @CalledByNative("AudioProcessing")
+    void process(int numBands, int numFrames, ByteBuffer buffer);
+  }
+
+  private long apmPtr;
+  private long capturePostProcessingPtr;
+  private long renderPreProcessingPtr;
+
+  public ExternalAudioProcessingFactory() {
+    apmPtr = nativeGetDefaultApm();
+    capturePostProcessingPtr = 0;
+    renderPreProcessingPtr = 0;
+  }
+
+  @Override
+  public long createNative(long webrtcEnvRef) {
+    if(apmPtr == 0) {
+      apmPtr = nativeGetDefaultApm();
+    }
+    return apmPtr;
+  }
+
+  /**
+   * Sets the capture post processing module. 
+   * This module is applied to the audio signal after capture and before sending 
+   * to the audio encoder.
+   */
+  public void setCapturePostProcessing(@Nullable AudioProcessing processing) {
+    checkExternalAudioProcessorExists();
+    long newPtr = nativeSetCapturePostProcessing(processing);
+    if (capturePostProcessingPtr != 0) {
+      JniCommon.nativeReleaseRef(capturePostProcessingPtr);
+      capturePostProcessingPtr = 0;
+    }
+    capturePostProcessingPtr = newPtr;
+  }
+
+  /**
+   * Sets the render pre processing module.
+   * This module is applied to the audio signal after receiving from the audio
+   * decoder and before rendering.
+   */
+  public void setRenderPreProcessing(@Nullable AudioProcessing processing) {
+    checkExternalAudioProcessorExists();
+    long newPtr = nativeSetRenderPreProcessing(processing);
+    if (renderPreProcessingPtr != 0) {
+      JniCommon.nativeReleaseRef(renderPreProcessingPtr);
+      renderPreProcessingPtr = 0;
+    }
+    renderPreProcessingPtr = newPtr;
+  }
+  
+  /**
+   * Sets the bypass flag for the capture post processing module.
+   * If true, the registered audio processing will be bypassed.
+   */
+  public void setBypassFlagForCapturePost( boolean bypass) {
+    checkExternalAudioProcessorExists();
+    nativeSetBypassFlagForCapturePost(bypass);
+  }
+
+  /**
+   * Sets the bypass flag for the render pre processing module.
+   * If true, the registered audio processing will be bypassed.
+   */
+  public void setBypassFlagForRenderPre( boolean bypass) {
+    checkExternalAudioProcessorExists();
+    nativeSetBypassFlagForRenderPre(bypass);
+  }
+
+  /**
+   * Destroys the ExternalAudioProcessor.
+   */
+  public void destroy() {
+    checkExternalAudioProcessorExists();
+    if (renderPreProcessingPtr != 0) {
+      JniCommon.nativeReleaseRef(renderPreProcessingPtr);
+      renderPreProcessingPtr = 0;
+    }
+    if (capturePostProcessingPtr != 0) {
+      JniCommon.nativeReleaseRef(capturePostProcessingPtr);
+      capturePostProcessingPtr = 0;
+    }
+    nativeDestroy();
+    apmPtr = 0;
+  }
+
+  private void checkExternalAudioProcessorExists() {
+    if (apmPtr == 0) {
+      throw new IllegalStateException("ExternalAudioProcessor has been disposed.");
+    }
+  }
+
+  /**
+   * Takamaka C-25 (2026-10-12): WebRTC's adaptive digital AGC (AGC2 adaptive digital controller + limiter) on the
+   * capture path, as the ONE software AGC stage — AGC1 stays off while it is on, whatever the track's
+   * autoGainControl option says. Android exposes no microphone gain, so the analog controller is never used.
+   */
+  public void setAdaptiveDigitalAgc(boolean enabled) {
+    checkExternalAudioProcessorExists();
+    nativeSetAdaptiveDigitalAgc(enabled);
+  }
+
+  /** The live AudioProcessing::Config as WebRTC prints it (for logs and device proofs). */
+  public String getAudioProcessingConfig() {
+    checkExternalAudioProcessorExists();
+    return nativeGetAudioProcessingConfig();
+  }
+
+  private static native long nativeGetDefaultApm();
+  private static native void nativeSetAdaptiveDigitalAgc(boolean enabled);
+  private static native String nativeGetAudioProcessingConfig();
+  private static native long nativeSetCapturePostProcessing(AudioProcessing processing);
+  private static native long nativeSetRenderPreProcessing(AudioProcessing processing);
+  private static native void nativeSetBypassFlagForCapturePost(boolean bypass);
+  private static native void nativeSetBypassFlagForRenderPre(boolean bypass);
+  private static native void nativeDestroy();
+}
diff --git a/sdk/android/api/org/webrtc/SFrameCryptor.java b/sdk/android/api/org/webrtc/SFrameCryptor.java
new file mode 100644
index 0000000..dbc0c42
--- /dev/null
+++ b/sdk/android/api/org/webrtc/SFrameCryptor.java
@@ -0,0 +1,72 @@
+/*
+ * Takamaka E2EE calls (C182 / DR-055).
+ *
+ * The RFC 9605 SFrame transformer attached to one RtpSender or RtpReceiver. It is active from the moment it is
+ * created — there is no enable switch and no pass-through: attach it BEFORE a track is set on the sender, so that no
+ * frame ever leaves unsealed, and before a receiver's track is rendered.
+ */
+
+package org.webrtc;
+
+public class SFrameCryptor {
+  public enum MediaKind {
+    AUDIO,
+    VIDEO;
+  }
+
+  private long nativeCryptor;
+
+  /** Attaches a sealing transformer to {@code sender}; frames are dropped until the store has a send KID. */
+  public static SFrameCryptor createForRtpSender(
+      RtpSender sender, SFrameKeyStore keyStore, MediaKind kind, String streamId) {
+    return new SFrameCryptor(nativeCreateForRtpSender(
+        sender.getNativeRtpSender(), keyStore.getNativeKeyStore(), kind.ordinal(), streamId));
+  }
+
+  /** Attaches an opening transformer to {@code receiver}; frames it cannot authenticate are dropped. */
+  public static SFrameCryptor createForRtpReceiver(
+      RtpReceiver receiver, SFrameKeyStore keyStore, MediaKind kind, String streamId) {
+    return new SFrameCryptor(nativeCreateForRtpReceiver(
+        receiver.getNativeRtpReceiver(), keyStore.getNativeKeyStore(), kind.ordinal(), streamId));
+  }
+
+  private SFrameCryptor(long nativeCryptor) {
+    this.nativeCryptor = nativeCryptor;
+  }
+
+  /** This stream's counters (frames, passed, drops by reason, storm, last KID) as JSON. */
+  public String getStatsJson() {
+    checkExists();
+    return nativeGetStatsJson(nativeCryptor);
+  }
+
+  /**
+   * S-7: binds this receive transformer to {@code legIndex} (1..65535) or unbinds it ({@code legIndex} &lt; 0); see
+   * {@link SFrameKeyStore#bindLeg}. False on a sender or a reserved index.
+   */
+  public boolean bindLeg(int legIndex) {
+    checkExists();
+    return nativeBindLeg(nativeCryptor, legIndex);
+  }
+
+  /**
+   * Releases the Java handle. The transformer stays attached to its sender/receiver (WebRTC keeps a reference) and
+   * keeps sealing/opening with its key store: disposing never turns encryption off.
+   */
+  public void dispose() {
+    checkExists();
+    JniCommon.nativeReleaseRef(nativeCryptor);
+    nativeCryptor = 0;
+  }
+
+  private void checkExists() {
+    if (nativeCryptor == 0) {
+      throw new IllegalStateException("SFrameCryptor has been disposed.");
+    }
+  }
+
+  private static native long nativeCreateForRtpSender(long rtpSender, long keyStore, int kind, String streamId);
+  private static native long nativeCreateForRtpReceiver(long rtpReceiver, long keyStore, int kind, String streamId);
+  private static native String nativeGetStatsJson(long cryptor);
+  private static native boolean nativeBindLeg(long cryptor, int legIndex);
+}
diff --git a/sdk/android/api/org/webrtc/SFrameKeyStore.java b/sdk/android/api/org/webrtc/SFrameKeyStore.java
new file mode 100644
index 0000000..f308ac4
--- /dev/null
+++ b/sdk/android/api/org/webrtc/SFrameKeyStore.java
@@ -0,0 +1,186 @@
+/*
+ * Takamaka E2EE calls (C182 / DR-055).
+ *
+ * The keys of one call for the RFC 9605 SFrame transformer (SFrameCryptor): suite 5 AES_256_GCM_SHA512,
+ * KID = leg_index * 2^16 + (epoch mod 2^16), one CTR space per KID, a 128-frame replay window per KID, the storm
+ * rule. Fail closed: no key, no send KID or an unknown KID means frames are DROPPED, never passed in clear.
+ * A deliberately separate API from FrameCryptor/FrameCryptorKeyProvider (whose unknown values silently fall back to
+ * the LiveKit cipher): on a binary without this class the call fails instead of running another cipher.
+ */
+
+package org.webrtc;
+
+import androidx.annotation.Nullable;
+
+public class SFrameKeyStore {
+  /** Result of {@link #setKey}. */
+  public enum SetKeyResult {
+    /** New key material for the KID: fresh replay window, stormed receive streams resumed. */
+    CHANGED,
+    /** The same material was already installed: nothing changed. */
+    UNCHANGED,
+    /** Reserved KID (leg_index 0, or more than 16 bits) or a base key that is not 32 bytes. */
+    INVALID;
+  }
+
+  /**
+   * Transformer events (storm, recovered, resumed, dropping, engaged, first-pass, key-expired, key-evicted, held,
+   * released). Called on a WebRTC media thread: return quickly, hand the event to your own thread. {@code count} =
+   * the frames released (type {@code released}), else 0.
+   */
+  public interface Observer {
+    @CalledByNative("Observer")
+    void onSFrameEvent(String type, String streamId, String reason, long kid, long consecutive, long count);
+  }
+
+  private long nativeKeyStore;
+
+  public static SFrameKeyStore create() {
+    return new SFrameKeyStore(nativeCreate());
+  }
+
+  private SFrameKeyStore(long nativeKeyStore) {
+    this.nativeKeyStore = nativeKeyStore;
+  }
+
+  /** Native pointer, for SFrameCryptor. */
+  long getNativeKeyStore() {
+    checkExists();
+    return nativeKeyStore;
+  }
+
+  /** Installs the RFC 9605 key and salt of {@code kid} derived from {@code baseKey} (sender_base_e, 32 bytes). */
+  public SetKeyResult setKey(long kid, byte[] baseKey) {
+    checkExists();
+    return SetKeyResult.values()[nativeSetKey(nativeKeyStore, kid, baseKey)];
+  }
+
+  public boolean removeKey(long kid) {
+    checkExists();
+    return nativeRemoveKey(nativeKeyStore, kid);
+  }
+
+  /** Keeps {@code kid} usable for {@code retentionMs} more milliseconds, then removes it. */
+  public boolean retireKey(long kid, long retentionMs) {
+    checkExists();
+    return nativeRetireKey(nativeKeyStore, kid, retentionMs);
+  }
+
+  /** The KID every sender of this store seals under; false if no key is installed for it. */
+  public boolean setSendKid(long kid) {
+    checkExists();
+    return nativeSetSendKid(nativeKeyStore, kid);
+  }
+
+  public void clearSendKid() {
+    checkExists();
+    nativeClearSendKid(nativeKeyStore);
+  }
+
+  /** The current send KID, or -1. */
+  public long getSendKid() {
+    checkExists();
+    return nativeGetSendKid(nativeKeyStore);
+  }
+
+  public void setStormThreshold(int n) {
+    checkExists();
+    nativeSetStormThreshold(nativeKeyStore, n);
+  }
+
+  /** H.264 units (spec §9.2 fallback layout). Off by default: H.264 frames are dropped. */
+  public void setH264Enabled(boolean enabled) {
+    checkExists();
+    nativeSetH264Enabled(nativeKeyStore, enabled);
+  }
+
+  /**
+   * C-24 (spec §9.2 [0.3]): how long a receive VIDEO stream holds frames of a known leg's next epoch(s) while their
+   * key is missing (default 10 s = the retention default); 0 turns holding off (such frames drop as unknown-kid).
+   */
+  public void setHoldTime(long holdMs) {
+    checkExists();
+    nativeSetHoldTime(nativeKeyStore, holdMs);
+  }
+
+  /**
+   * S-7 (ruling Q1): when on, a receive stream opens frames only after {@link #bindLeg} gave it a leg, and only under
+   * KIDs of that leg (kid >> 16); others drop as "unbound" / "wrong-leg" and count toward the storm (Q3). ON by
+   * default since tkm.10 (Iris §7.117 item 2, ruling R2) and a one-way latch: {@code setRequireLegBinding(false)} is
+   * ignored once the flag is on — so, with the default, always; passing {@code true} is a no-op kept for the callers
+   * of tkm.9. Independently of the flag, a stream that was ever bound treats a later unbind as closed ("unbound"),
+   * never as "open any KID".
+   */
+  public void setRequireLegBinding(boolean required) {
+    checkExists();
+    nativeSetRequireLegBinding(nativeKeyStore, required);
+  }
+
+  /**
+   * S-7: binds every receive stream labelled {@code streamId} to {@code legIndex} (1..65535), or unbinds it
+   * ({@code legIndex} &lt; 0). A change drops the frames the stream holds and restarts its storm count. False if no
+   * receive stream has that label or the index is reserved.
+   */
+  public boolean bindLeg(String streamId, int legIndex) {
+    checkExists();
+    return nativeBindLeg(nativeKeyStore, streamId, legIndex);
+  }
+
+  public void setObserver(@Nullable Observer observer) {
+    checkExists();
+    nativeSetObserver(nativeKeyStore, observer);
+  }
+
+  /** Counters of every live stream of this store, as a JSON array. */
+  public String getStatsJson() {
+    checkExists();
+    return nativeGetStatsJson(nativeKeyStore);
+  }
+
+  /**
+   * Vector check (no live key involved): seals ONE Opus/VP8-shaped unit with the transformer's own derivation and
+   * AEAD, under the key of {@code kid} derived from {@code baseKey}, with an explicit {@code ctr}. Null on error.
+   */
+  @Nullable
+  public static byte[] vectorSeal(byte[] baseKey, long kid, long ctr, byte[] frame, int prefixLen) {
+    return nativeVectorSeal(baseKey, kid, ctr, frame, prefixLen);
+  }
+
+  /** Vector check: opens ONE unit sealed under {@code kid}/{@code baseKey}. Null on any failure (bad tag, other KID). */
+  @Nullable
+  public static byte[] vectorOpen(byte[] baseKey, long kid, byte[] unit, int prefixLen) {
+    return nativeVectorOpen(baseKey, kid, unit, prefixLen);
+  }
+
+  public void dispose() {
+    checkExists();
+    nativeSetObserver(nativeKeyStore, null);
+    JniCommon.nativeReleaseRef(nativeKeyStore);
+    nativeKeyStore = 0;
+  }
+
+  private void checkExists() {
+    if (nativeKeyStore == 0) {
+      throw new IllegalStateException("SFrameKeyStore has been disposed.");
+    }
+  }
+
+  private static native long nativeCreate();
+  private static native int nativeSetKey(long keyStore, long kid, byte[] baseKey);
+  private static native boolean nativeRemoveKey(long keyStore, long kid);
+  private static native boolean nativeRetireKey(long keyStore, long kid, long retentionMs);
+  private static native boolean nativeSetSendKid(long keyStore, long kid);
+  private static native void nativeClearSendKid(long keyStore);
+  private static native long nativeGetSendKid(long keyStore);
+  private static native void nativeSetStormThreshold(long keyStore, int n);
+  private static native void nativeSetH264Enabled(long keyStore, boolean enabled);
+  private static native void nativeSetHoldTime(long keyStore, long holdMs);
+  private static native void nativeSetRequireLegBinding(long keyStore, boolean required);
+  private static native boolean nativeBindLeg(long keyStore, String streamId, int legIndex);
+  private static native void nativeSetObserver(long keyStore, @Nullable Observer observer);
+  private static native String nativeGetStatsJson(long keyStore);
+  @Nullable
+  private static native byte[] nativeVectorSeal(byte[] baseKey, long kid, long ctr, byte[] frame, int prefixLen);
+  @Nullable
+  private static native byte[] nativeVectorOpen(byte[] baseKey, long kid, byte[] unit, int prefixLen);
+}
