+static jboolean JNI_SFrameKeyStore_BindLeg(
+    JNIEnv* env,
+    jlong j_store,
+    const JavaParamRef<jstring>& j_stream_id,
+    jint j_leg_index) {
+  if (j_stream_id.is_null()) {
+    return false;
+  }
+  return Store(j_store)->BindLeg(JavaToStdString(env, j_stream_id),
+                                 LegFromJava(j_leg_index));
+}
+
+static void JNI_SFrameKeyStore_SetObserver(
+    JNIEnv* env,
+    jlong j_store,
+    const JavaParamRef<jobject>& j_observer) {
+  if (j_observer.is_null()) {
+    Store(j_store)->SetObserver(nullptr);
+    return;
+  }
+  Store(j_store)->SetObserver(
+      make_ref_counted<SframeObserverJni>(env, j_observer));
+}
+
+static ScopedJavaLocalRef<jstring> JNI_SFrameKeyStore_GetStatsJson(
+    JNIEnv* env,
+    jlong j_store) {
+  std::string j = "[";
+  bool first = true;
+  for (const SframeStreamStats& s : Store(j_store)->GetAllStats()) {
+    j += first ? "" : ",";
+    first = false;
+    j += StatsJson(s);
+  }
+  return NativeToJavaString(env, j + "]");
+}
+
+static ScopedJavaLocalRef<jbyteArray> JNI_SFrameKeyStore_VectorSeal(
+    JNIEnv* env,
+    const JavaParamRef<jbyteArray>& j_base_key,
+    jlong j_kid,
+    jlong j_ctr,
+    const JavaParamRef<jbyteArray>& j_frame,
+    jint j_prefix_len) {
+  if (j_base_key.is_null() || j_frame.is_null() || j_kid < 0 || j_ctr < 0 ||
+      j_prefix_len < 0) {
+    return nullptr;
+  }
+  std::vector<int8_t> base = JavaToNativeByteArray(env, j_base_key);
+  const std::vector<int8_t> frame = JavaToNativeByteArray(env, j_frame);
+  const std::vector<uint8_t> unit = SframeKeyStore::VectorSeal(
+      std::span<const uint8_t>(reinterpret_cast<const uint8_t*>(base.data()),
+                               base.size()),
+      static_cast<uint64_t>(j_kid), static_cast<uint64_t>(j_ctr),
+      std::span<const uint8_t>(reinterpret_cast<const uint8_t*>(frame.data()),
+                               frame.size()),
+      static_cast<size_t>(j_prefix_len));
+  std::fill(base.begin(), base.end(), 0);
+  if (unit.empty()) {
+    return nullptr;
+  }
+  std::vector<int8_t> out(unit.begin(), unit.end());
+  return NativeToJavaByteArray(env, std::span<int8_t>(out));
+}
+
+static ScopedJavaLocalRef<jbyteArray> JNI_SFrameKeyStore_VectorOpen(
+    JNIEnv* env,
+    const JavaParamRef<jbyteArray>& j_base_key,
+    jlong j_kid,
+    const JavaParamRef<jbyteArray>& j_unit,
+    jint j_prefix_len) {
+  if (j_base_key.is_null() || j_unit.is_null() || j_kid < 0 ||
+      j_prefix_len < 0) {
+    return nullptr;
+  }
+  std::vector<int8_t> base = JavaToNativeByteArray(env, j_base_key);
+  const std::vector<int8_t> unit = JavaToNativeByteArray(env, j_unit);
+  const std::optional<std::vector<uint8_t>> frame = SframeKeyStore::VectorOpen(
+      std::span<const uint8_t>(reinterpret_cast<const uint8_t*>(base.data()),
+                               base.size()),
+      static_cast<uint64_t>(j_kid),
+      std::span<const uint8_t>(reinterpret_cast<const uint8_t*>(unit.data()),
+                               unit.size()),
+      static_cast<size_t>(j_prefix_len));
+  std::fill(base.begin(), base.end(), 0);
+  if (!frame) {
+    return nullptr;
+  }
+  std::vector<int8_t> out(frame->begin(), frame->end());
+  return NativeToJavaByteArray(env, std::span<int8_t>(out));
+}
+
+// ---- SFrameCryptor
+// ----------------------------------------------------------------------------------------------
+
+static jlong JNI_SFrameCryptor_CreateForRtpSender(
+    JNIEnv* env,
+    jlong j_rtp_sender,
+    jlong j_store,
+    jint j_kind,
+    const JavaParamRef<jstring>& j_stream_id) {
+  auto* sender = reinterpret_cast<RtpSenderInterface*>(j_rtp_sender);
+  scoped_refptr<SframeTransformer> t = SframeTransformer::Create(
+      scoped_refptr<SframeKeyStore>(Store(j_store)), SframeRole::kSender,
+      KindFromIndex(j_kind), JavaToStdString(env, j_stream_id));
+  sender->SetFrameTransformer(t);
+  return jlongFromPointer(t.release());
+}
+
+static jlong JNI_SFrameCryptor_CreateForRtpReceiver(
+    JNIEnv* env,
+    jlong j_rtp_receiver,
+    jlong j_store,
+    jint j_kind,
+    const JavaParamRef<jstring>& j_stream_id) {
+  auto* receiver = reinterpret_cast<RtpReceiverInterface*>(j_rtp_receiver);
+  scoped_refptr<SframeTransformer> t = SframeTransformer::Create(
+      scoped_refptr<SframeKeyStore>(Store(j_store)), SframeRole::kReceiver,
+      KindFromIndex(j_kind), JavaToStdString(env, j_stream_id));
+  receiver->SetFrameTransformer(t);
+  return jlongFromPointer(t.release());
+}
+
+static jboolean JNI_SFrameCryptor_BindLeg(JNIEnv* env,
+                                          jlong j_cryptor,
+                                          jint j_leg_index) {
+  return reinterpret_cast<SframeTransformer*>(j_cryptor)->BindLeg(
+      LegFromJava(j_leg_index));
+}
+
+static ScopedJavaLocalRef<jstring> JNI_SFrameCryptor_GetStatsJson(
+    JNIEnv* env,
+    jlong j_cryptor) {
+  return NativeToJavaString(
+      env,
+      StatsJson(reinterpret_cast<SframeTransformer*>(j_cryptor)->GetStats()));
+}
+
+}  // namespace jni
+}  // namespace webrtc
diff --git a/sdk/objc/api/peerconnection/RTCSFrameCryptor.h b/sdk/objc/api/peerconnection/RTCSFrameCryptor.h
new file mode 100644
index 0000000..0292268
--- /dev/null
+++ b/sdk/objc/api/peerconnection/RTCSFrameCryptor.h
@@ -0,0 +1,52 @@
+/*
+ * Takamaka E2EE calls (C182 / DR-055) — attaches the RFC 9605 SFrame
+ * transformer of an RTCSFrameKeyStore to one RTCRtpSender (seals) or one
+ * RTCRtpReceiver (opens). Twin of the Android org.webrtc.SFrameCryptor.
+ *
+ * Active from creation: there is no enable switch and no pass-through. The
+ * transformer stays attached to the sender/receiver for its life (WebRTC has no
+ * detach); attaching another one replaces it.
+ */
+
+#import <Foundation/Foundation.h>
+
+#import "RTCMacros.h"
+#import "RTCSFrameKeyStore.h"
+
+NS_ASSUME_NONNULL_BEGIN
+
+@class RTC_OBJC_TYPE(RTCRtpSender);
+@class RTC_OBJC_TYPE(RTCRtpReceiver);
+
+RTC_OBJC_EXPORT
+@interface RTC_OBJC_TYPE (RTCSFrameCryptor) : NSObject
+
+@property(nonatomic, readonly) NSString *streamId;
+@property(nonatomic, readonly) RTCSFrameMediaKind mediaKind;
+/** YES for a sealing (sender) transformer, NO for an opening (receiver) one. */
+@property(nonatomic, readonly) BOOL isSender;
+
+- (instancetype)init NS_UNAVAILABLE;
+
+- (nullable instancetype)initWithRtpSender:(RTC_OBJC_TYPE(RTCRtpSender) *)sender
+                                  keyStore:(RTC_OBJC_TYPE(RTCSFrameKeyStore) *)keyStore
+                                 mediaKind:(RTCSFrameMediaKind)mediaKind
+                                  streamId:(NSString *)streamId;
+
+- (nullable instancetype)initWithRtpReceiver:(RTC_OBJC_TYPE(RTCRtpReceiver) *)receiver
+                                    keyStore:(RTC_OBJC_TYPE(RTCSFrameKeyStore) *)keyStore
+                                   mediaKind:(RTCSFrameMediaKind)mediaKind
+                                    streamId:(NSString *)streamId;
+
+/**
+ * S-7: binds this receive transformer to `legIndex` (1..65535) or unbinds it (`legIndex` < 0); see
+ * -[RTCSFrameKeyStore bindLeg:streamId:]. NO on a sender or a reserved index.
+ */
+- (BOOL)bindLeg:(NSInteger)legIndex;
+
+/** Counters of this stream as a JSON object. */
+- (NSString *)statsJson;
+
+@end
+
+NS_ASSUME_NONNULL_END
diff --git a/sdk/objc/api/peerconnection/RTCSFrameCryptor.mm b/sdk/objc/api/peerconnection/RTCSFrameCryptor.mm
new file mode 100644
index 0000000..20d77b1
--- /dev/null
+++ b/sdk/objc/api/peerconnection/RTCSFrameCryptor.mm
@@ -0,0 +1,85 @@
+/*
+ * Takamaka E2EE calls (C182 / DR-055) — RTCSFrameCryptor: one SframeTransformer
+ * attached to one RtpSender (seal) or RtpReceiver (open).
+ */
+
+#import "RTCSFrameCryptor.h"
+
+#import "RTCRtpReceiver+Private.h"
+#import "RTCRtpSender+Private.h"
+#import "RTCSFrameKeyStore+Private.h"
+#import "helpers/NSString+StdString.h"
+
+#include "api/crypto/sframe_transformer.h"
+#include "api/rtp_receiver_interface.h"
+#include "api/rtp_sender_interface.h"
+
+@implementation RTC_OBJC_TYPE (RTCSFrameCryptor) {
+  webrtc::scoped_refptr<webrtc::SframeTransformer> _transformer;
+}
+
+@synthesize streamId = _streamId;
+@synthesize mediaKind = _mediaKind;
+@synthesize isSender = _isSender;
+
+static webrtc::SframeMediaKind NativeKind(RTCSFrameMediaKind kind) {
+  return kind == RTCSFrameMediaKindAudio ? webrtc::SframeMediaKind::kAudio
+                                         : webrtc::SframeMediaKind::kVideo;
+}
+
+- (nullable instancetype)initWithRtpSender:(RTC_OBJC_TYPE(RTCRtpSender) *)sender
+                                  keyStore:(RTC_OBJC_TYPE(RTCSFrameKeyStore) *)keyStore
+                                 mediaKind:(RTCSFrameMediaKind)mediaKind
+                                  streamId:(NSString *)streamId {
+  self = [super init];
+  if (self) {
+    webrtc::scoped_refptr<webrtc::RtpSenderInterface> nativeSender = sender.nativeRtpSender;
+    if (nativeSender == nullptr || keyStore == nil) {
+      return nil;
+    }
+    _streamId = [streamId copy];
+    _mediaKind = mediaKind;
+    _isSender = YES;
+    _transformer = webrtc::SframeTransformer::Create(keyStore.nativeKeyStore,
+                                                     webrtc::SframeRole::kSender,
+                                                     NativeKind(mediaKind),
+                                                     [streamId stdString]);
+    // The proxy marshals to the signaling thread (RtpSenderBase requires it).
+    nativeSender->SetFrameTransformer(_transformer);
+  }
+  return self;
+}
+
+- (nullable instancetype)initWithRtpReceiver:(RTC_OBJC_TYPE(RTCRtpReceiver) *)receiver
+                                    keyStore:(RTC_OBJC_TYPE(RTCSFrameKeyStore) *)keyStore
+                                   mediaKind:(RTCSFrameMediaKind)mediaKind
+                                    streamId:(NSString *)streamId {
+  self = [super init];
+  if (self) {
+    webrtc::scoped_refptr<webrtc::RtpReceiverInterface> nativeReceiver = receiver.nativeRtpReceiver;
+    if (nativeReceiver == nullptr || keyStore == nil) {
+      return nil;
+    }
+    _streamId = [streamId copy];
+    _mediaKind = mediaKind;
+    _isSender = NO;
+    _transformer = webrtc::SframeTransformer::Create(keyStore.nativeKeyStore,
+                                                     webrtc::SframeRole::kReceiver,
+                                                     NativeKind(mediaKind),
+                                                     [streamId stdString]);
+    nativeReceiver->SetFrameTransformer(_transformer);
+  }
+  return self;
+}
+
+- (BOOL)bindLeg:(NSInteger)legIndex {
+  // S-7: legIndex < 0 = unbind
+  return _transformer->BindLeg(
+      legIndex < 0 ? std::nullopt : std::optional<uint32_t>(static_cast<uint32_t>(legIndex)));
+}
+
+- (NSString *)statsJson {
+  return [NSString stringForStdString:webrtc::RTCSFrameStatsJson(_transformer->GetStats())];
+}
+
+@end
