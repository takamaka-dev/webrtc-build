+// ---- C-24: hold video frames of a known leg's next epoch until the key
+// arrives
+// ---------------------------------------------------------------------------------------
+
+// Alice (leg 1) rotates from epoch 4 to 5 and seals under KID(1,5) before Bob
+// installed that key: Bob HOLDS the three frames (nothing dropped, nothing
+// passed), then opens all of them, in order, the moment the key lands — the
+// VP8 reference chain stays whole (no PLI, no freeze).
+TEST(SframeTransformer, VideoUnderTheNextEpochIsHeldUntilItsKeyArrives) {
+  SimulatedClock clock(Timestamp::Seconds(1000));
+  Leg alice(&clock), bob(&clock);
+  const uint64_t e4 = kUnitsKid, e5 = kUnitsKid + 1;  // KID(1,4), KID(1,5)
+  ASSERT_EQ(alice.store->SetKey(e4, kBase), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_TRUE(alice.store->SetSendKid(e4));
+  ASSERT_EQ(bob.store->SetKey(e4, kBase), SframeKeyStore::SetKeyResult::kChanged);
+  auto sv = alice.Make(SframeRole::kSender, SframeMediaKind::kVideo, "sv");
+  auto rv = bob.Make(SframeRole::kReceiver, SframeMediaKind::kVideo, "rv");
+  auto& sent = alice.sinks["sv"]->frames;
+  auto& got = bob.sinks["rv"]->frames;
+
+  sv->Transform(VideoFrame({0x10, 1, 2, 3, 4}, Direction::kSender));
+  rv->Transform(VideoFrame(sent[0], Direction::kReceiver));
+  ASSERT_EQ(got.size(), 1u);
+
+  // the switch at the sender; Bob's key for e5 is late
+  ASSERT_EQ(alice.store->SetKey(e5, OtherBase()), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_TRUE(alice.store->SetSendKid(e5));
+  for (uint8_t i = 1; i <= 3; ++i) {
+    sv->Transform(VideoFrame({0x10, i, i, i}, Direction::kSender));
+    clock.AdvanceTime(TimeDelta::Millis(66));
+  }
+  for (size_t i = 1; i <= 3; ++i) {
+    rv->Transform(VideoFrame(sent[i], Direction::kReceiver));
+  }
+  SframeStreamStats st = rv->GetStats();
+  EXPECT_EQ(got.size(), 1u) << "nothing passes while the key is missing";
+  EXPECT_EQ(st.dropped_total(), 0u) << "held, not dropped";
+  EXPECT_EQ(st.held, 3u);
+  EXPECT_EQ(st.held_now, 3u);
+  EXPECT_EQ(st.frames, 4u);
+  EXPECT_EQ(st.consecutive, 0u) << "a held frame does not count toward the storm";
+  EXPECT_EQ(bob.recorder->Count(SframeEvent::Type::kHeld, "rv"), 1);
+
+  // the key lands: every held frame opens, in order, delivered by SetKey
+  ASSERT_EQ(bob.store->SetKey(e5, OtherBase()), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_EQ(got.size(), 4u);
+  for (uint8_t i = 1; i <= 3; ++i) {
+    EXPECT_EQ(got[i], std::vector<uint8_t>({0x10, i, i, i}));
+  }
+  st = rv->GetStats();
+  EXPECT_EQ(st.held_released, 3u);
+  EXPECT_EQ(st.held_now, 0u);
+  EXPECT_EQ(st.passed, 4u);
+  EXPECT_EQ(st.dropped_total(), 0u);
+  ASSERT_EQ(bob.recorder->Count(SframeEvent::Type::kReleased, "rv"), 1);
+  for (const SframeEvent& e : bob.recorder->events) {
+    if (e.type == SframeEvent::Type::kReleased) {
+      EXPECT_EQ(e.count, 3u);
+      EXPECT_EQ(e.kid, e5);
+    }
+  }
+  // the stream keeps working live under e5 (replay window continued)
+  sv->Transform(VideoFrame({0x10, 9}, Direction::kSender));
+  rv->Transform(VideoFrame(sent[4], Direction::kReceiver));
+  EXPECT_EQ(got.size(), 5u);
+  EXPECT_EQ(rv->GetStats().dropped_total(), 0u);
+}
+
+// A key that never comes: the held frames drop after the hold time
+// (held-expired, counting toward the storm like unknown-kid); the queue is
+// bounded (the oldest drops as held-overflow); SetHoldTime(0) turns holding
+// off (plain unknown-kid drops).
+TEST(SframeTransformer, HeldFramesExpireAndTheHoldIsBounded) {
+  SimulatedClock clock(Timestamp::Seconds(1000));
+  Leg alice(&clock), bob(&clock);
+  const uint64_t e4 = kUnitsKid, e5 = kUnitsKid + 1;
+  ASSERT_EQ(alice.store->SetKey(e5, kBase), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_TRUE(alice.store->SetSendKid(e5));
+  ASSERT_EQ(bob.store->SetKey(e4, kBase), SframeKeyStore::SetKeyResult::kChanged);
+  auto sv = alice.Make(SframeRole::kSender, SframeMediaKind::kVideo, "sv");
+  auto rv = bob.Make(SframeRole::kReceiver, SframeMediaKind::kVideo, "rv");
+  auto& sent = alice.sinks["sv"]->frames;
+
+  // expiry: 2 frames held at t0, the hold time (10 s) passes, the next
+  // frame's processing purges them
+  sv->Transform(VideoFrame({0x10, 1}, Direction::kSender));
+  sv->Transform(VideoFrame({0x10, 2}, Direction::kSender));
+  rv->Transform(VideoFrame(sent[0], Direction::kReceiver));
+  rv->Transform(VideoFrame(sent[1], Direction::kReceiver));
+  EXPECT_EQ(rv->GetStats().held_now, 2u);
+  clock.AdvanceTime(TimeDelta::Millis(SframeKeyStore::kDefaultHoldMs - 1));
+  sv->Transform(VideoFrame({0x10, 3}, Direction::kSender));
+  rv->Transform(VideoFrame(sent[2], Direction::kReceiver));  // held too
+  EXPECT_EQ(rv->GetStats().held_now, 3u);
+  EXPECT_EQ(Dropped(rv->GetStats(), SframeDropReason::kHeldExpired), 0u);
+  clock.AdvanceTime(TimeDelta::Millis(1));
+  bob.store->SetSendKid(e4);  // any store entry purges: the first two expire
+  SframeStreamStats st = rv->GetStats();
+  EXPECT_EQ(Dropped(st, SframeDropReason::kHeldExpired), 2u);
+  EXPECT_EQ(st.held_now, 1u);
+  EXPECT_EQ(st.consecutive, 2u) << "an expired hold is an unknown-kid drop that waited";
+  EXPECT_EQ(st.drop_samples.size(), 2u);
+  EXPECT_EQ(st.drop_samples[0].rfind("held-expired len=", 0), 0u);
+  // the late key still opens the third frame
+  ASSERT_EQ(bob.store->SetKey(e5, kBase), SframeKeyStore::SetKeyResult::kChanged);
+  EXPECT_EQ(bob.sinks["rv"]->frames.size(), 1u);
+  EXPECT_EQ(rv->GetStats().held_now, 0u);
+
+  // bound: a second rotation the receiver never learns of; the queue keeps
+  // the newest kMaxHeldFrames
+  const uint64_t e6 = kUnitsKid + 2;
+  ASSERT_EQ(alice.store->SetKey(e6, OtherBase()), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_TRUE(alice.store->SetSendKid(e6));
+  const size_t before = sent.size();
+  for (size_t i = 0; i < SframeKeyStore::kMaxHeldFrames + 5; ++i) {
+    sv->Transform(VideoFrame({0x10, static_cast<uint8_t>(i)}, Direction::kSender));
+    rv->Transform(VideoFrame(sent[before + i], Direction::kReceiver));
+  }
+  st = rv->GetStats();
+  EXPECT_EQ(st.held_now, SframeKeyStore::kMaxHeldFrames);
+  EXPECT_EQ(Dropped(st, SframeDropReason::kHeldOverflow), 5u);
+  EXPECT_EQ(st.consecutive, 5u) << "an overflowing hold counts like unknown-kid drops (toward N = 30)";
+
+  // holding off: the queue drains as expired, new frames drop at once
+  bob.store->SetHoldTime(TimeDelta::Zero());
+  st = rv->GetStats();
+  EXPECT_EQ(st.held_now, 0u);
+  EXPECT_EQ(Dropped(st, SframeDropReason::kHeldExpired), 2u + SframeKeyStore::kMaxHeldFrames);
+  sv->Transform(VideoFrame({0x10, 7}, Direction::kSender));
+  rv->Transform(VideoFrame(sent.back(), Direction::kReceiver));
+  EXPECT_EQ(Dropped(rv->GetStats(), SframeDropReason::kUnknownKid), 1u);
+}
+
+// Only VIDEO of a KNOWN leg, 1..kHoldEpochsAhead epochs AHEAD, is held: audio
+// drops (Opus PLC), an unknown leg drops (the relay's blank frame, a stranger),
+// an epoch behind the window drops (its key expired), an epoch too far ahead
+// drops; the epoch field wraps mod 2^16.
+TEST(SframeTransformer, OnlyVideoOfAKnownLegsNextEpochsIsHeld) {
+  Leg alice, bob;
+  auto kid = [](uint32_t leg, uint64_t epoch) { return *sframe::MakeKid(leg, epoch); };
+  ASSERT_EQ(bob.store->SetKey(kid(1, 65535), kBase), SframeKeyStore::SetKeyResult::kChanged);
+  auto sv = alice.Make(SframeRole::kSender, SframeMediaKind::kVideo, "sv");
+  auto sa = alice.Make(SframeRole::kSender, SframeMediaKind::kAudio, "sa");
+  auto rv = bob.Make(SframeRole::kReceiver, SframeMediaKind::kVideo, "rv");
+  auto ra = bob.Make(SframeRole::kReceiver, SframeMediaKind::kAudio, "ra");
+  auto seal = [&](uint64_t k, SframeMediaKind kind) {
+    ASSERT_NE(alice.store->SetKey(k, kBase), SframeKeyStore::SetKeyResult::kInvalid);
+    ASSERT_TRUE(alice.store->SetSendKid(k));
+    if (kind == SframeMediaKind::kVideo) {
+      sv->Transform(VideoFrame({0x10, 1, 2}, Direction::kSender));
+      rv->Transform(VideoFrame(alice.sinks["sv"]->frames.back(), Direction::kReceiver));
+    } else {
+      sa->Transform(AudioFrame({0x78, 1, 2}, Direction::kSender));
+      ra->Transform(AudioFrame(alice.sinks["sa"]->frames.back(), Direction::kReceiver));
+    }
+  };
+  seal(kid(1, 65536), SframeMediaKind::kVideo);  // epoch 65536 ≡ 0: one ahead of 65535 (wrap)
+  EXPECT_EQ(rv->GetStats().held_now, 1u);
+  seal(kid(1, 65535 + SframeKeyStore::kHoldEpochsAhead), SframeMediaKind::kVideo);
+  EXPECT_EQ(rv->GetStats().held_now, 2u);
+  seal(kid(1, 65535 + SframeKeyStore::kHoldEpochsAhead + 1), SframeMediaKind::kVideo);  // too far ahead
+  EXPECT_EQ(rv->GetStats().held_now, 2u);
+  EXPECT_EQ(Dropped(rv->GetStats(), SframeDropReason::kUnknownKid), 1u);
+  seal(kid(1, 65534), SframeMediaKind::kVideo);  // behind: its key is gone
+  EXPECT_EQ(Dropped(rv->GetStats(), SframeDropReason::kUnknownKid), 2u);
+  seal(kid(2, 65536), SframeMediaKind::kVideo);  // an unknown leg
+  EXPECT_EQ(Dropped(rv->GetStats(), SframeDropReason::kUnknownKid), 3u);
+  seal(kid(1, 65536), SframeMediaKind::kAudio);  // audio: never held
+  EXPECT_EQ(ra->GetStats().held_now, 0u);
+  EXPECT_EQ(Dropped(ra->GetStats(), SframeDropReason::kUnknownKid), 1u);
+  EXPECT_EQ(rv->GetStats().held_now, 2u);
+  // the two keys arrive in any order: each releases its own frame
+  ASSERT_EQ(bob.store->SetKey(kid(1, 65535 + SframeKeyStore::kHoldEpochsAhead), kBase),
+            SframeKeyStore::SetKeyResult::kChanged);
+  EXPECT_EQ(bob.sinks["rv"]->frames.size(), 1u);
+  EXPECT_EQ(rv->GetStats().held_now, 1u);
+  ASSERT_EQ(bob.store->SetKey(kid(1, 65536), kBase), SframeKeyStore::SetKeyResult::kChanged);
+  EXPECT_EQ(bob.sinks["rv"]->frames.size(), 2u);
+  EXPECT_EQ(rv->GetStats().held_now, 0u);
+  EXPECT_EQ(rv->GetStats().held_released, 2u);
+  // a frame the sink cannot take any more (unregistered) drops as no-sink on release
+  seal(kid(1, 65537), SframeMediaKind::kVideo);
+  EXPECT_EQ(rv->GetStats().held_now, 1u);
+  rv->UnregisterTransformedFrameCallback();
+  ASSERT_EQ(bob.store->SetKey(kid(1, 65537), kBase), SframeKeyStore::SetKeyResult::kChanged);
+  EXPECT_EQ(Dropped(rv->GetStats(), SframeDropReason::kNoSink), 1u);
+  EXPECT_EQ(rv->GetStats().held_now, 0u);
+}
+
+// ---- S-7: leg binding (a relay participant ↔ the KIDs of its frames)
+// ----------------------------------------------------------------------------
+
+// Alice is leg 1, Carol leg 2; Bob holds both keys (one store per call). Bob's
+// receive stream for Alice's track, bound to leg 1, opens Alice's frames and
+// drops Carol's as wrong-leg — the relay cannot route Carol's media under
+// Alice's identity. A wrong-leg frame touches nothing: no replay window (the
+// same unit still opens on Carol's own stream), no last_kid.
+TEST(SframeTransformer, BoundReceiverOpensOnlyItsOwnLegsKids) {
+  Leg alice, carol, bob;
+  auto kid = [](uint32_t leg, uint64_t epoch) { return *sframe::MakeKid(leg, epoch); };
+  ASSERT_EQ(alice.store->SetKey(kid(1, 4), kBase), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_TRUE(alice.store->SetSendKid(kid(1, 4)));
+  ASSERT_EQ(carol.store->SetKey(kid(2, 4), OtherBase()), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_TRUE(carol.store->SetSendKid(kid(2, 4)));
+  ASSERT_EQ(bob.store->SetKey(kid(1, 4), kBase), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_EQ(bob.store->SetKey(kid(2, 4), OtherBase()), SframeKeyStore::SetKeyResult::kChanged);
+  auto sa = alice.Make(SframeRole::kSender, SframeMediaKind::kAudio, "sa");
+  auto sc = carol.Make(SframeRole::kSender, SframeMediaKind::kAudio, "sc");
+  auto ra = bob.Make(SframeRole::kReceiver, SframeMediaKind::kAudio, "recv:audio:alice");
+  auto rc = bob.Make(SframeRole::kReceiver, SframeMediaKind::kAudio, "recv:audio:carol");
+  sa->Transform(AudioFrame({0x78, 1, 1}, Direction::kSender));
+  sc->Transform(AudioFrame({0x78, 2, 2}, Direction::kSender));
+  const std::vector<uint8_t> from_alice = alice.sinks["sa"]->frames.back();
+  const std::vector<uint8_t> from_carol = carol.sinks["sc"]->frames.back();
+
+  ASSERT_TRUE(bob.store->BindLeg("recv:audio:alice", 1));
+  EXPECT_EQ(ra->GetStats().bound_leg, std::optional<uint32_t>(1));
+  ra->Transform(AudioFrame(from_carol, Direction::kReceiver));  // re-routed
+  SframeStreamStats st = ra->GetStats();
+  EXPECT_EQ(Dropped(st, SframeDropReason::kWrongLeg), 1u);
+  EXPECT_EQ(st.passed, 0u);
+  EXPECT_FALSE(st.last_kid.has_value()) << "a wrong-leg KID is not this stream's history";
+  EXPECT_EQ(st.consecutive, 1u) << "Q3: wrong-leg counts toward the storm";
+  ASSERT_EQ(st.drop_samples.size(), 1u);
+  EXPECT_EQ(st.drop_samples[0].rfind("wrong-leg len=", 0), 0u);
+  ra->Transform(AudioFrame(from_alice, Direction::kReceiver));
+  EXPECT_EQ(bob.sinks["recv:audio:alice"]->frames.size(), 1u);
+  EXPECT_EQ(ra->GetStats().consecutive, 0u);
+  // Carol's unit never reached the replay window: it still opens where it
+  // belongs (rc bound to leg 2 through the transformer API).
+  ASSERT_TRUE(rc->BindLeg(2));
+  rc->Transform(AudioFrame(from_carol, Direction::kReceiver));
+  EXPECT_EQ(bob.sinks["recv:audio:carol"]->frames.size(), 1u);
+  EXPECT_EQ(Dropped(rc->GetStats(), SframeDropReason::kReplay), 0u);
+  // Without a binding and with require_leg_binding forced off by the fixture
+  // (tkm.10 requires it by default: RequireLegBindingIsOnByDefaultAndLatched)
+  // a never-bound stream opens any installed KID: the filter is the binding.
+  auto rx = bob.Make(SframeRole::kReceiver, SframeMediaKind::kAudio, "rx");
+  sc->Transform(AudioFrame({0x78, 3}, Direction::kSender));
+  rx->Transform(AudioFrame(carol.sinks["sc"]->frames.back(), Direction::kReceiver));
+  EXPECT_EQ(bob.sinks["rx"]->frames.size(), 1u);
+}
+
+// Q1: with require_leg_binding an unbound receive stream opens NOTHING (the
+// participant is not, or no longer, in the verified roster) — 'unbound', and
+// it counts toward the storm (Q3). Binding resumes a stormed stream with a
+// fresh count; unbinding closes it again. BindLeg refuses unknown streams,
+// senders and reserved leg indexes.
+TEST(SframeTransformer, RequiredBindingDropsUnboundFramesUntilBound) {
+  Leg alice, bob;
+  bob.store->SetRequireLegBinding(true);
+  EXPECT_TRUE(bob.store->require_leg_binding());
+  ASSERT_EQ(alice.store->SetKey(kUnitsKid, kBase), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_TRUE(alice.store->SetSendKid(kUnitsKid));
+  ASSERT_EQ(bob.store->SetKey(kUnitsKid, kBase), SframeKeyStore::SetKeyResult::kChanged);
+  auto sv = alice.Make(SframeRole::kSender, SframeMediaKind::kVideo, "sv");
+  auto rv = bob.Make(SframeRole::kReceiver, SframeMediaKind::kVideo, "rv");
+  auto& sent = alice.sinks["sv"]->frames;
+  auto& got = bob.sinks["rv"]->frames;
+  for (int i = 0; i < SframeKeyStore::kDefaultStormThreshold; ++i) {
+    sv->Transform(VideoFrame({0x10, static_cast<uint8_t>(i)}, Direction::kSender));
+    rv->Transform(VideoFrame(sent.back(), Direction::kReceiver));
+  }
+  SframeStreamStats st = rv->GetStats();
+  EXPECT_TRUE(got.empty()) << "Q1: an unbound receiver never opens";
+  EXPECT_EQ(Dropped(st, SframeDropReason::kUnbound),
+            static_cast<uint64_t>(SframeKeyStore::kDefaultStormThreshold));
+  EXPECT_TRUE(st.storm) << "Q3: unbound drops count toward the storm";
+  EXPECT_EQ(bob.recorder->Count(SframeEvent::Type::kStorm, "rv"), 1);
+  EXPECT_EQ(st.held_now, 0u) << "an unbound stream holds nothing";
+
+  EXPECT_FALSE(bob.store->BindLeg("nope", 1));
+  EXPECT_FALSE(bob.store->BindLeg("rv", 0)) << "leg_index 0 is reserved";
+  EXPECT_FALSE(bob.store->BindLeg("rv", 0x10000));
+  EXPECT_FALSE(sv->BindLeg(1)) << "a sender has no leg to bind";
+  EXPECT_FALSE(rv->GetStats().bound_leg.has_value());
+
+  ASSERT_TRUE(bob.store->BindLeg("rv", 1));
+  st = rv->GetStats();
+  EXPECT_FALSE(st.storm);
+  EXPECT_EQ(st.consecutive, 0u);
+  EXPECT_EQ(bob.recorder->Count(SframeEvent::Type::kResumed, "rv"), 1);
+  sv->Transform(VideoFrame({0x10, 0x55}, Direction::kSender));
+  rv->Transform(VideoFrame(sent.back(), Direction::kReceiver));
+  ASSERT_EQ(got.size(), 1u);
+  EXPECT_EQ(got[0], std::vector<uint8_t>({0x10, 0x55}));
+  ASSERT_TRUE(bob.store->BindLeg("rv", 1));  // the same leg again: a no-op
+  EXPECT_EQ(bob.recorder->Count(SframeEvent::Type::kResumed, "rv"), 1);
+
+  // The participant leaves the verified roster: unbound again, nothing opens.
+  ASSERT_TRUE(bob.store->BindLeg("rv", std::nullopt));
+  sv->Transform(VideoFrame({0x10, 0x56}, Direction::kSender));
+  rv->Transform(VideoFrame(sent.back(), Direction::kReceiver));
+  EXPECT_EQ(got.size(), 1u);
+  EXPECT_EQ(Dropped(rv->GetStats(), SframeDropReason::kUnbound),
+            static_cast<uint64_t>(SframeKeyStore::kDefaultStormThreshold) + 1);
+}
+
+// C-24 × S-7: a bound stream holds only for ITS leg's next epoch; the next
+// epoch of another known leg drops wrong-leg at once. A rebind drops what was
+// held for the old leg.
+TEST(SframeTransformer, BoundStreamHoldsOnlyForItsOwnLeg) {
+  Leg alice, bob;
+  auto kid = [](uint32_t leg, uint64_t epoch) { return *sframe::MakeKid(leg, epoch); };
+  ASSERT_EQ(bob.store->SetKey(kid(1, 4), kBase), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_EQ(bob.store->SetKey(kid(2, 4), kBase), SframeKeyStore::SetKeyResult::kChanged);
+  auto sv = alice.Make(SframeRole::kSender, SframeMediaKind::kVideo, "sv");
+  auto rv = bob.Make(SframeRole::kReceiver, SframeMediaKind::kVideo, "rv");
+  ASSERT_TRUE(rv->BindLeg(1));
+  auto seal = [&](uint64_t k) {
+    ASSERT_NE(alice.store->SetKey(k, kBase), SframeKeyStore::SetKeyResult::kInvalid);
+    ASSERT_TRUE(alice.store->SetSendKid(k));
+    sv->Transform(VideoFrame({0x10, 1, 2}, Direction::kSender));
+    rv->Transform(VideoFrame(alice.sinks["sv"]->frames.back(), Direction::kReceiver));
+  };
+  seal(kid(1, 5));  // its own leg's next epoch: held
+  EXPECT_EQ(rv->GetStats().held_now, 1u);
+  seal(kid(2, 5));  // a known leg's next epoch, but not this stream's
+  SframeStreamStats st = rv->GetStats();
+  EXPECT_EQ(st.held_now, 1u);
+  EXPECT_EQ(Dropped(st, SframeDropReason::kWrongLeg), 1u);
+  EXPECT_EQ(st.consecutive, 1u);
+  // rebind to leg 2: the frame held for leg 1 goes, the count restarts
+  ASSERT_TRUE(rv->BindLeg(2));
+  st = rv->GetStats();
+  EXPECT_EQ(st.held_now, 0u);
+  EXPECT_EQ(Dropped(st, SframeDropReason::kWrongLeg), 2u);
+  EXPECT_EQ(st.consecutive, 0u);
+  ASSERT_EQ(bob.store->SetKey(kid(1, 5), kBase), SframeKeyStore::SetKeyResult::kChanged);
+  EXPECT_TRUE(bob.sinks["rv"]->frames.empty()) << "nothing of leg 1 is released into a leg-2 stream";
+  EXPECT_EQ(rv->GetStats().held_released, 0u);
+}
+
+// H.264 units are filtered the same way (the leg check runs per slice, before
+// the key lookup).
+TEST(SframeTransformer, H264UnitsOfAnotherLegAreDroppedWrongLeg) {
+  Leg alice, bob;
+  alice.store->SetH264Enabled(true);
+  bob.store->SetH264Enabled(true);
+  bob.store->SetRequireLegBinding(true);
+  ASSERT_EQ(alice.store->SetKey(kUnitsKid, kBase), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_TRUE(alice.store->SetSendKid(kUnitsKid));
+  ASSERT_EQ(bob.store->SetKey(kUnitsKid, kBase), SframeKeyStore::SetKeyResult::kChanged);
+  auto sv = alice.Make(SframeRole::kSender, SframeMediaKind::kVideo, "sv");
+  auto rv = bob.Make(SframeRole::kReceiver, SframeMediaKind::kVideo, "rv");
+  const std::vector<uint8_t> idr =
+      AnnexB({kSps, kPps, Slice({0x65, 0x88, 0x84}, 300, 7)});
+  sv->Transform(VideoFrame(idr, Direction::kSender, "video/H264"));
+  ASSERT_EQ(alice.sinks["sv"]->frames.size(), 1u);
+  const std::vector<uint8_t> unit = alice.sinks["sv"]->frames[0];
+  rv->Transform(VideoFrame(unit, Direction::kReceiver, "video/H264"));
+  EXPECT_EQ(Dropped(rv->GetStats(), SframeDropReason::kUnbound), 1u);
+  ASSERT_TRUE(rv->BindLeg(2));
+  rv->Transform(VideoFrame(unit, Direction::kReceiver, "video/H264"));
+  EXPECT_EQ(Dropped(rv->GetStats(), SframeDropReason::kWrongLeg), 1u);
+  ASSERT_TRUE(rv->BindLeg(1));
+  rv->Transform(VideoFrame(unit, Direction::kReceiver, "video/H264"));
+  ASSERT_EQ(bob.sinks["rv"]->frames.size(), 1u);
+  EXPECT_EQ(bob.sinks["rv"]->frames[0], idr);
+}
+
+TEST(SframeTransformer, LegBindingDropReasonNames) {
+  EXPECT_STREQ(SframeDropReasonName(SframeDropReason::kUnbound), "unbound");
+  EXPECT_STREQ(SframeDropReasonName(SframeDropReason::kWrongLeg), "wrong-leg");
+  EXPECT_TRUE(SframeDropCountsForStorm(SframeDropReason::kUnbound));
+  EXPECT_TRUE(SframeDropCountsForStorm(SframeDropReason::kWrongLeg));
+}
+
+// ---- S-7 hardening, tkm.10 (Iris §7.117 item 2 + native nits 8n1 / 8n3)
+// ----------------------------------------------------------------------------
+
+// R2: the binding is required by default, and the flag is a one-way latch —
+// SetRequireLegBinding(false) is ignored, whether the flag is on by default or
+// was set on explicitly. A store as the bindings create it opens nothing on
+// an unbound receiver until BindLeg.
+TEST(SframeTransformer, RequireLegBindingIsOnByDefaultAndLatched) {
+  auto raw = SframeKeyStore::Create();
+  EXPECT_TRUE(raw->require_leg_binding()) << "R2: on by default";
+  raw->SetRequireLegBinding(false);
+  EXPECT_TRUE(raw->require_leg_binding()) << "a one-way latch: false is ignored";
+  raw->SetRequireLegBinding(true);
+  EXPECT_TRUE(raw->require_leg_binding());
+  SframeKeyStoreTestPeer::ForceRequireLegBinding(*raw, false);
+  ASSERT_FALSE(raw->require_leg_binding());
+  raw->SetRequireLegBinding(true);  // the tkm.9 callers' explicit true
+  raw->SetRequireLegBinding(false);
+  EXPECT_TRUE(raw->require_leg_binding()) << "latched on again";
+
+  Leg alice, bob(nullptr, /*require_leg_binding=*/true);
+  ASSERT_EQ(alice.store->SetKey(kUnitsKid, kBase), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_TRUE(alice.store->SetSendKid(kUnitsKid));
+  ASSERT_EQ(bob.store->SetKey(kUnitsKid, kBase), SframeKeyStore::SetKeyResult::kChanged);
+  auto sa = alice.Make(SframeRole::kSender, SframeMediaKind::kAudio, "sa");
+  auto ra = bob.Make(SframeRole::kReceiver, SframeMediaKind::kAudio, "ra");
+  sa->Transform(AudioFrame({0x78, 1, 2}, Direction::kSender));
+  ra->Transform(AudioFrame(alice.sinks["sa"]->frames.back(), Direction::kReceiver));
+  EXPECT_TRUE(bob.sinks["ra"]->frames.empty()) << "unbound by default = closed";
+  EXPECT_EQ(Dropped(ra->GetStats(), SframeDropReason::kUnbound), 1u);
+  ASSERT_TRUE(ra->BindLeg(sframe::LegIndexOf(kUnitsKid)));
+  sa->Transform(AudioFrame({0x78, 1, 3}, Direction::kSender));
+  ra->Transform(AudioFrame(alice.sinks["sa"]->frames.back(), Direction::kReceiver));
+  EXPECT_EQ(bob.sinks["ra"]->frames.size(), 1u);
+}
+
+// The per-stream latch: a stream that was bound once treats a later unbind as
+// closed even with the store's flag off (defence in depth under the store
+// latch) — a participant who left the verified roster never falls back to
+// "any KID". It is per stream: a never-bound stream of the same store still
+// opens with the flag off. And no key resumes it once stormed: only BindLeg.
+TEST(SframeTransformer, EverBoundStreamStaysClosedOnceUnboundWhateverTheFlag) {
+  Leg alice, bob;  // the fixture forces the flag off
+  ASSERT_FALSE(bob.store->require_leg_binding());
+  auto kid = [](uint32_t leg, uint64_t epoch) { return *sframe::MakeKid(leg, epoch); };
+  ASSERT_EQ(alice.store->SetKey(kid(1, 4), kBase), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_TRUE(alice.store->SetSendKid(kid(1, 4)));
+  ASSERT_EQ(bob.store->SetKey(kid(1, 4), kBase), SframeKeyStore::SetKeyResult::kChanged);
+  auto sa = alice.Make(SframeRole::kSender, SframeMediaKind::kAudio, "sa");
+  auto ra = bob.Make(SframeRole::kReceiver, SframeMediaKind::kAudio, "ra");
+  auto rx = bob.Make(SframeRole::kReceiver, SframeMediaKind::kAudio, "rx");
+  auto next = [&] {
+    sa->Transform(AudioFrame({0x78, 1, 2}, Direction::kSender));
+    return alice.sinks["sa"]->frames.back();
+  };
+  auto& got = bob.sinks["ra"]->frames;
+  ra->Transform(AudioFrame(next(), Direction::kReceiver));
+  EXPECT_EQ(got.size(), 1u) << "flag off, never bound: opens";
+  ASSERT_TRUE(ra->BindLeg(1));
+  ra->Transform(AudioFrame(next(), Direction::kReceiver));
+  EXPECT_EQ(got.size(), 2u);
+  ASSERT_TRUE(ra->BindLeg(std::nullopt));  // left the roster
+  for (int i = 0; i < SframeKeyStore::kDefaultStormThreshold; ++i) {
+    ra->Transform(AudioFrame(next(), Direction::kReceiver));
+  }
+  SframeStreamStats st = ra->GetStats();
+  EXPECT_EQ(got.size(), 2u) << "bound once: unbound = closed";
+  EXPECT_EQ(Dropped(st, SframeDropReason::kUnbound),
+            static_cast<uint64_t>(SframeKeyStore::kDefaultStormThreshold));
+  EXPECT_TRUE(st.storm);
+  rx->Transform(AudioFrame(next(), Direction::kReceiver));
+  EXPECT_EQ(bob.sinks["rx"]->frames.size(), 1u) << "per stream: a never-bound one still opens";
+  // rx opening kid(1, 4) — ra's last_kid — does not "recover" ra, and a new
+  // key resumes nothing here either (8n3): a closed stream cannot recover by
+  // a pass elsewhere or by a key, only by BindLeg.
+  EXPECT_TRUE(ra->GetStats().storm);
+  EXPECT_EQ(bob.recorder->Count(SframeEvent::Type::kRecovered, "ra"), 0);
+  ASSERT_EQ(bob.store->SetKey(kid(1, 5), kBase), SframeKeyStore::SetKeyResult::kChanged);
+  EXPECT_TRUE(ra->GetStats().storm);
+  EXPECT_EQ(bob.recorder->Count(SframeEvent::Type::kResumed, "ra"), 0);
+  ASSERT_TRUE(ra->BindLeg(1));
+  EXPECT_FALSE(ra->GetStats().storm);
+  EXPECT_EQ(bob.recorder->Count(SframeEvent::Type::kResumed, "ra"), 1);
+  ra->Transform(AudioFrame(next(), Direction::kReceiver));
+  EXPECT_EQ(got.size(), 3u);
+}
+
+// 8n1: a wire KID of 2^48 or more has a leg index wider than 16 bits, which no
+// key can carry; through the 32-bit LegIndexOf it aliased the bound leg
+// (2^48 + leg·2^16 → leg), passed the leg check, missed the key lookup as
+// unknown-kid and wrote itself into last_kid. Now it is wrong-leg before any
+// of that, and the drop event names it.
+TEST(SframeTransformer, WireKidBeyond48BitsIsWrongLegNotAnAliasOfTheBoundLeg) {
+  Leg bob(nullptr, /*require_leg_binding=*/true);
+  ASSERT_EQ(bob.store->SetKey(kUnitsKid, kBase), SframeKeyStore::SetKeyResult::kChanged);
+  auto ra = bob.Make(SframeRole::kReceiver, SframeMediaKind::kAudio, "ra");
+  ASSERT_TRUE(ra->BindLeg(1));
+  const uint64_t alias = (uint64_t{1} << 48) | kUnitsKid;
+  ASSERT_EQ(sframe::LegIndexOf(alias), 1u) << "the 32-bit view aliases leg 1";
+  ASSERT_FALSE(sframe::IsAssignableKid(alias));
+  std::vector<uint8_t> frame = {0x78};  // Opus TOC
+  const std::vector<uint8_t> header = sframe::EncodeHeader(alias, 0);
+  frame.insert(frame.end(), header.begin(), header.end());
+  frame.resize(frame.size() + 2 * sframe::kTagSize, 0x42);  // "ciphertext" + tag
+  ra->Transform(AudioFrame(frame, Direction::kReceiver));
+  const SframeStreamStats st = ra->GetStats();
+  EXPECT_EQ(Dropped(st, SframeDropReason::kWrongLeg), 1u);
+  EXPECT_EQ(Dropped(st, SframeDropReason::kUnknownKid), 0u);
+  EXPECT_FALSE(st.last_kid.has_value()) << "never this stream's history";
+  const SframeEvent* e = bob.recorder->Last(SframeEvent::Type::kDropping, "ra");
+  ASSERT_NE(e, nullptr);
+  EXPECT_EQ(e->reason, SframeDropReason::kWrongLeg);
+  EXPECT_EQ(e->kid, alias);
+  // the genuine KID still opens on the same stream afterwards
+  Leg alice;
+  ASSERT_EQ(alice.store->SetKey(kUnitsKid, kBase), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_TRUE(alice.store->SetSendKid(kUnitsKid));
+  auto sa = alice.Make(SframeRole::kSender, SframeMediaKind::kAudio, "sa");
+  sa->Transform(AudioFrame({0x78, 1, 2}, Direction::kSender));
+  ra->Transform(AudioFrame(alice.sinks["sa"]->frames.back(), Direction::kReceiver));
+  EXPECT_EQ(bob.sinks["ra"]->frames.size(), 1u);
+}
+
+// 8n3: a key arriving resumes stormed receive streams (spec §9.2 [0.2]) — but
+// not an unbound stream that opens nothing: no key can recover it, only
+// BindLeg, and a resumed / storm pair per epoch would flap the app's
+// subscription toward the SFU. A bound stream stormed on a missing key still
+// resumes on that key.
+TEST(SframeTransformer, SetKeyLeavesAClosedUnboundStreamStormed) {
+  Leg alice, bob(nullptr, /*require_leg_binding=*/true);
+  auto kid = [](uint32_t leg, uint64_t epoch) { return *sframe::MakeKid(leg, epoch); };
+  ASSERT_EQ(bob.store->SetKey(kid(1, 4), kBase), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_EQ(alice.store->SetKey(kid(1, 5), kBase), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_TRUE(alice.store->SetSendKid(kid(1, 5)));  // an epoch bob lacks
+  auto sa = alice.Make(SframeRole::kSender, SframeMediaKind::kAudio, "sa");
+  auto ru = bob.Make(SframeRole::kReceiver, SframeMediaKind::kAudio, "ru");  // unbound
+  auto rb = bob.Make(SframeRole::kReceiver, SframeMediaKind::kAudio, "rb");
+  ASSERT_TRUE(rb->BindLeg(1));
+  auto storm = [&] {
+    for (int i = 0; i < SframeKeyStore::kDefaultStormThreshold; ++i) {
+      sa->Transform(AudioFrame({0x78, 1, 2}, Direction::kSender));
+      ru->Transform(AudioFrame(alice.sinks["sa"]->frames.back(), Direction::kReceiver));
+      rb->Transform(AudioFrame(alice.sinks["sa"]->frames.back(), Direction::kReceiver));
+    }
+  };
+  storm();
+  EXPECT_TRUE(ru->GetStats().storm);
+  EXPECT_TRUE(rb->GetStats().storm);
+  EXPECT_EQ(Dropped(ru->GetStats(), SframeDropReason::kUnbound),
+            static_cast<uint64_t>(SframeKeyStore::kDefaultStormThreshold));
+  EXPECT_EQ(Dropped(rb->GetStats(), SframeDropReason::kUnknownKid),
+            static_cast<uint64_t>(SframeKeyStore::kDefaultStormThreshold));
+  EXPECT_EQ(bob.recorder->Count(SframeEvent::Type::kStorm, "ru"), 1);
+  EXPECT_EQ(bob.recorder->Count(SframeEvent::Type::kStorm, "rb"), 1);
+
+  ASSERT_EQ(bob.store->SetKey(kid(1, 5), kBase), SframeKeyStore::SetKeyResult::kChanged);
+  EXPECT_FALSE(rb->GetStats().storm) << "a bound stream resumes on the key";
+  EXPECT_EQ(bob.recorder->Count(SframeEvent::Type::kResumed, "rb"), 1);
+  EXPECT_TRUE(ru->GetStats().storm) << "an unbound one cannot recover by a key";
+  EXPECT_EQ(bob.recorder->Count(SframeEvent::Type::kResumed, "ru"), 0);
+  EXPECT_EQ(ru->GetStats().consecutive,
+            static_cast<uint64_t>(SframeKeyStore::kDefaultStormThreshold));
+  storm();  // still stormed, not a second storm (no flapping)
+  EXPECT_EQ(bob.recorder->Count(SframeEvent::Type::kStorm, "ru"), 1);
+  EXPECT_EQ(bob.sinks["rb"]->frames.size(),
+            static_cast<size_t>(SframeKeyStore::kDefaultStormThreshold));
+
+  ASSERT_TRUE(ru->BindLeg(1));  // the one way back
+  EXPECT_FALSE(ru->GetStats().storm);
+  EXPECT_EQ(bob.recorder->Count(SframeEvent::Type::kResumed, "ru"), 1);
+  sa->Transform(AudioFrame({0x78, 1, 2}, Direction::kSender));
+  ru->Transform(AudioFrame(alice.sinks["sa"]->frames.back(), Direction::kReceiver));
+  EXPECT_EQ(bob.sinks["ru"]->frames.size(), 1u);
+}
+
+// 8n3: kDropping / kStorm carry the dropped frame's KID, not last_kid — which
+// an unbound or wrong-leg frame never writes (so it was absent or stale: the
+// last KID that DID pass the leg check).
+TEST(SframeTransformer, DropAndStormEventsCarryTheFramesKid) {
+  Leg alice, carol, bob(nullptr, /*require_leg_binding=*/true);
+  auto kid = [](uint32_t leg, uint64_t epoch) { return *sframe::MakeKid(leg, epoch); };
+  ASSERT_EQ(alice.store->SetKey(kid(1, 4), kBase), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_TRUE(alice.store->SetSendKid(kid(1, 4)));
+  ASSERT_EQ(carol.store->SetKey(kid(2, 4), OtherBase()), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_TRUE(carol.store->SetSendKid(kid(2, 4)));
+  ASSERT_EQ(bob.store->SetKey(kid(1, 4), kBase), SframeKeyStore::SetKeyResult::kChanged);
+  ASSERT_EQ(bob.store->SetKey(kid(2, 4), OtherBase()), SframeKeyStore::SetKeyResult::kChanged);
+  auto sa = alice.Make(SframeRole::kSender, SframeMediaKind::kAudio, "sa");
+  auto sc = carol.Make(SframeRole::kSender, SframeMediaKind::kAudio, "sc");
+  auto ra = bob.Make(SframeRole::kReceiver, SframeMediaKind::kAudio, "ra");
+
+  sa->Transform(AudioFrame({0x78, 1, 2}, Direction::kSender));
+  ra->Transform(AudioFrame(alice.sinks["sa"]->frames.back(), Direction::kReceiver));
+  const SframeEvent* e = bob.recorder->Last(SframeEvent::Type::kDropping, "ra");
+  ASSERT_NE(e, nullptr);
+  EXPECT_EQ(e->reason, SframeDropReason::kUnbound);
+  EXPECT_EQ(e->kid, kid(1, 4)) << "the unbound frame's KID (last_kid is unset)";
+  EXPECT_FALSE(ra->GetStats().last_kid.has_value());
+
+  ASSERT_TRUE(ra->BindLeg(1));
+  ra->Transform(AudioFrame(alice.sinks["sa"]->frames.back(), Direction::kReceiver));
+  EXPECT_EQ(ra->GetStats().last_kid, kid(1, 4));
+  for (int i = 0; i < SframeKeyStore::kDefaultStormThreshold; ++i) {
+    sc->Transform(AudioFrame({0x78, 2, 2}, Direction::kSender));
+    ra->Transform(AudioFrame(carol.sinks["sc"]->frames.back(), Direction::kReceiver));  // re-routed
+  }
+  e = bob.recorder->Last(SframeEvent::Type::kDropping, "ra");
+  ASSERT_NE(e, nullptr);
+  EXPECT_EQ(e->reason, SframeDropReason::kWrongLeg);
+  EXPECT_EQ(e->kid, kid(2, 4)) << "the re-routed frame's KID, not last_kid = kid(1, 4)";
+  e = bob.recorder->Last(SframeEvent::Type::kStorm, "ra");
+  ASSERT_NE(e, nullptr);
+  EXPECT_EQ(e->reason, SframeDropReason::kWrongLeg);
+  EXPECT_EQ(e->kid, kid(2, 4));
+  EXPECT_EQ(e->consecutive, static_cast<uint64_t>(SframeKeyStore::kDefaultStormThreshold));
+  EXPECT_EQ(ra->GetStats().last_kid, kid(1, 4)) << "wrong-leg never wrote it";
+
+  // sender side: the send KID (nullopt when there is none)
+  auto sx = bob.Make(SframeRole::kSender, SframeMediaKind::kAudio, "sx");
+  sx->Transform(AudioFrame({0x78, 1}, Direction::kSender));
+  e = bob.recorder->Last(SframeEvent::Type::kDropping, "sx");
+  ASSERT_NE(e, nullptr);
+  EXPECT_EQ(e->reason, SframeDropReason::kNoKey);
+  EXPECT_FALSE(e->kid.has_value());
+}
