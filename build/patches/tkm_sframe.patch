diff --git a/api/crypto/sframe_core.cc b/api/crypto/sframe_core.cc
new file mode 100644
index 0000000..865ce95
--- /dev/null
+++ b/api/crypto/sframe_core.cc
@@ -0,0 +1,432 @@
+/*
+ * Takamaka E2EE calls (C182 / DR-055) — RFC 9605 SFrame primitives, cipher
+ * suite 5. See sframe_core.h.
+ */
+
+#include "api/crypto/sframe_core.h"
+
+#include <openssl/aead.h>
+#include <openssl/digest.h>
+#include <openssl/hkdf.h>
+#include <openssl/mem.h>
+
+#include <algorithm>
+#include <cstring>
+#include <string_view>
+
+#include "rtc_base/bitstream_reader.h"
+
+namespace webrtc {
+namespace sframe {
+
+namespace {
+
+// Minimal big-endian length of v (>= 1 byte).
+size_t MinLen(uint64_t v) {
+  size_t n = 1;
+  while (n < 8 && v >= (uint64_t{1} << (8 * n))) {
+    ++n;
+  }
+  return n;
+}
+
+void AppendBe(uint64_t v, size_t n, std::vector<uint8_t>* out) {
+  for (size_t i = n; i-- > 0;) {
+    out->push_back(static_cast<uint8_t>(v >> (8 * i)));
+  }
+}
+
+uint64_t ReadBe(std::span<const uint8_t> b, size_t pos, size_t n) {
+  uint64_t v = 0;
+  for (size_t i = 0; i < n; ++i) {
+    v = (v << 8) | b[pos + i];
+  }
+  return v;
+}
+
+std::vector<uint8_t> Label(std::string_view prefix, uint64_t kid) {
+  std::vector<uint8_t> out(prefix.begin(), prefix.end());
+  AppendBe(kid, 8, &out);
+  AppendBe(kCipherSuite, 2, &out);
+  return out;
+}
+
+}  // namespace
+
+// ---- KID
+// ----------------------------------------------------------------------------------------------------------
+
+std::optional<uint64_t> MakeKid(uint32_t leg_index, uint64_t epoch) {
+  if (leg_index > 0xFFFF) {
+    return std::nullopt;
+  }
+  return (uint64_t{leg_index} << 16) | (epoch & 0xFFFF);
+}
+
+// ---- header
+// -------------------------------------------------------------------------------------------------------
+
+std::vector<uint8_t> EncodeHeader(uint64_t kid, uint64_t ctr) {
+  std::vector<uint8_t> out;
+  out.reserve(kMaxHeaderSize);
+  out.push_back(0);
+  uint8_t config = 0;
+  if (kid < 8) {
+    config |= static_cast<uint8_t>(kid << 4);
+  } else {
+    size_t n = MinLen(kid);
+    config |= 0x80 | static_cast<uint8_t>((n - 1) << 4);
+    AppendBe(kid, n, &out);
+  }
+  if (ctr < 8) {
+    config |= static_cast<uint8_t>(ctr);
+  } else {
+    size_t n = MinLen(ctr);
+    config |= 0x08 | static_cast<uint8_t>(n - 1);
+    AppendBe(ctr, n, &out);
+  }
+  out[0] = config;
+  return out;
+}
+
+std::optional<Header> ParseHeader(std::span<const uint8_t> data) {
+  if (data.empty()) {
+    return std::nullopt;
+  }
+  const uint8_t config = data[0];
+  size_t pos = 1;
+  Header h;
+  if (config & 0x80) {
+    size_t n = ((config >> 4) & 0x07) + 1;
+    if (pos + n > data.size()) {
+      return std::nullopt;  // truncated KID
+    }
+    h.kid = ReadBe(data, pos, n);
+    pos += n;
+    if (h.kid < 8 || MinLen(h.kid) != n) {
+      return std::nullopt;  // non-minimal KID
+    }
+  } else {
+    h.kid = (config >> 4) & 0x07;
+  }
+  if (config & 0x08) {
+    size_t n = (config & 0x07) + 1;
+    if (pos + n > data.size()) {
+      return std::nullopt;  // truncated CTR
+    }
+    h.ctr = ReadBe(data, pos, n);
+    pos += n;
+    if (h.ctr < 8 || MinLen(h.ctr) != n) {
+      return std::nullopt;  // non-minimal CTR
+    }
+  } else {
+    h.ctr = config & 0x07;
+  }
+  h.length = pos;
+  return h;
+}
+
+// ---- key schedule
+// -------------------------------------------------------------------------------------------------
+
+KeyMaterial::~KeyMaterial() {
+  OPENSSL_cleanse(key.data(), key.size());
+  OPENSSL_cleanse(salt.data(), salt.size());
+}
+
+std::vector<uint8_t> KeyLabel(uint64_t kid) {
+  return Label("SFrame 1.0 Secret key ", kid);
+}
+
+std::vector<uint8_t> SaltLabel(uint64_t kid) {
+  return Label("SFrame 1.0 Secret salt ", kid);
+}
+
+bool DeriveKeyMaterial(uint64_t kid,
+                       std::span<const uint8_t> base_key,
+                       KeyMaterial* out,
+                       std::array<uint8_t, kSecretSize>* secret_out) {
+  if (base_key.empty() || out == nullptr) {
+    return false;
+  }
+  std::array<uint8_t, kSecretSize> secret{};
+  size_t secret_len = 0;
+  // HKDF-Extract with an empty salt (RFC 5869: HashLen zeros, which HMAC pads
+  // an empty key to anyway).
+  bool ok = HKDF_extract(secret.data(), &secret_len, EVP_sha512(),
+                         base_key.data(), base_key.size(), nullptr, 0) == 1 &&
+            secret_len == kSecretSize;
+  const std::vector<uint8_t> key_label = KeyLabel(kid);
+  const std::vector<uint8_t> salt_label = SaltLabel(kid);
+  ok =
+      ok &&
+      HKDF_expand(out->key.data(), out->key.size(), EVP_sha512(), secret.data(),
+                  secret.size(), key_label.data(), key_label.size()) == 1 &&
+      HKDF_expand(out->salt.data(), out->salt.size(), EVP_sha512(),
+                  secret.data(), secret.size(), salt_label.data(),
+                  salt_label.size()) == 1;
+  if (ok && secret_out != nullptr) {
+    *secret_out = secret;
+  }
+  OPENSSL_cleanse(secret.data(), secret.size());
+  return ok;
+}
+
+std::array<uint8_t, kNonceSize> MakeNonce(
+    std::span<const uint8_t, kNonceSize> salt,
+    uint64_t ctr) {
+  std::array<uint8_t, kNonceSize> n{};
+  std::copy(salt.begin(), salt.end(), n.begin());
+  for (size_t i = 0; i < 8; ++i) {
+    n[kNonceSize - 1 - i] ^= static_cast<uint8_t>(ctr >> (8 * i));
+  }
+  return n;
+}
+
+// ---- AEAD
+// ---------------------------------------------------------------------------------------------------------
+
+struct SealingKey::Impl {
+  bssl::ScopedEVP_AEAD_CTX ctx;
+};
+
+SealingKey::SealingKey() : impl_(std::make_unique<Impl>()) {}
+
+SealingKey::~SealingKey() {
+  OPENSSL_cleanse(key_.data(), key_.size());
+  OPENSSL_cleanse(salt_.data(), salt_.size());
+}
+
+std::unique_ptr<SealingKey> SealingKey::Create(uint64_t kid,
+                                               const KeyMaterial& material) {
+  std::unique_ptr<SealingKey> k(new SealingKey());
+  k->kid_ = kid;
+  k->key_ = material.key;
+  k->salt_ = material.salt;
+  if (EVP_AEAD_CTX_init(k->impl_->ctx.get(), EVP_aead_aes_256_gcm(),
+                        k->key_.data(), k->key_.size(), kTagSize,
+                        nullptr) != 1) {
+    return nullptr;
+  }
+  return k;
+}
+
+bool SealingKey::SameMaterial(const KeyMaterial& other) const {
+  return CRYPTO_memcmp(key_.data(), other.key.data(), kKeySize) == 0 &&
+         CRYPTO_memcmp(salt_.data(), other.salt.data(), kNonceSize) == 0;
+}
+
+bool SealingKey::Seal(uint64_t ctr,
+                      std::span<const uint8_t> header,
+                      std::span<const uint8_t> metadata,
+                      std::span<const uint8_t> plaintext,
+                      std::vector<uint8_t>* out) const {
+  std::vector<uint8_t> aad(header.begin(), header.end());
+  aad.insert(aad.end(), metadata.begin(), metadata.end());
+  const std::array<uint8_t, kNonceSize> nonce =
+      MakeNonce(std::span<const uint8_t, kNonceSize>(salt_), ctr);
+  const size_t old = out->size();
+  out->resize(old + plaintext.size() + kTagSize);
+  size_t written = 0;
+  const std::span<uint8_t> dst = std::span<uint8_t>(*out).subspan(old);
+  if (EVP_AEAD_CTX_seal(impl_->ctx.get(), dst.data(), &written, dst.size(),
+                        nonce.data(), nonce.size(), plaintext.data(),
+                        plaintext.size(), aad.data(), aad.size()) != 1 ||
+      written != plaintext.size() + kTagSize) {
+    out->resize(old);
+    return false;
+  }
+  return true;
+}
+
+bool SealingKey::Open(uint64_t ctr,
+                      std::span<const uint8_t> header,
+                      std::span<const uint8_t> metadata,
+                      std::span<const uint8_t> ct_and_tag,
+                      std::vector<uint8_t>* out) const {
+  if (ct_and_tag.size() < kTagSize) {
+    return false;
+  }
+  std::vector<uint8_t> aad(header.begin(), header.end());
+  aad.insert(aad.end(), metadata.begin(), metadata.end());
+  const std::array<uint8_t, kNonceSize> nonce =
+      MakeNonce(std::span<const uint8_t, kNonceSize>(salt_), ctr);
+  const size_t old = out->size();
+  out->resize(old + ct_and_tag.size());
+  size_t written = 0;
+  const std::span<uint8_t> dst = std::span<uint8_t>(*out).subspan(old);
+  if (EVP_AEAD_CTX_open(impl_->ctx.get(), dst.data(), &written, dst.size(),
+                        nonce.data(), nonce.size(), ct_and_tag.data(),
+                        ct_and_tag.size(), aad.data(), aad.size()) != 1) {
+    out->resize(old);
+    return false;
+  }
+  out->resize(old + written);
+  return true;
+}
+
+std::vector<uint8_t> Encrypt(const SealingKey& key,
+                             uint64_t ctr,
+                             std::span<const uint8_t> metadata,
+                             std::span<const uint8_t> plaintext) {
+  std::vector<uint8_t> out = EncodeHeader(key.kid(), ctr);
+  const std::vector<uint8_t> header = out;
+  if (!key.Seal(ctr, header, metadata, plaintext, &out)) {
+    return {};
+  }
+  return out;
+}
+
+std::optional<std::vector<uint8_t>> Decrypt(
+    const SealingKey& key,
+    std::span<const uint8_t> metadata,
+    std::span<const uint8_t> sframe_ciphertext) {
+  std::optional<Header> h = ParseHeader(sframe_ciphertext);
+  if (!h || h->kid != key.kid()) {
+    return std::nullopt;
+  }
+  std::vector<uint8_t> out;
+  if (!key.Open(h->ctr, sframe_ciphertext.first(h->length), metadata,
+                sframe_ciphertext.subspan(h->length), &out)) {
+    return std::nullopt;
+  }
+  return out;
+}
+
+// ---- replay window
+// ------------------------------------------------------------------------------------------------
+
+ReplayWindow::Verdict ReplayWindow::Check(uint64_t ctr) const {
+  if (!any_ || ctr > highest_) {
+    return Verdict::kOk;
+  }
+  if (highest_ - ctr >= kReplayWindow) {
+    return Verdict::kTooOld;
+  }
+  return seen_[ctr % kReplayWindow] ? Verdict::kReplay : Verdict::kOk;
+}
+
+void ReplayWindow::Commit(uint64_t ctr) {
+  if (!any_) {
+    any_ = true;
+    seen_.reset();
+    highest_ = ctr;
+  } else if (ctr > highest_) {
+    const uint64_t gap = std::min<uint64_t>(ctr - highest_, kReplayWindow);
+    for (uint64_t i = 1; i <= gap; ++i) {
+      seen_[(highest_ + i) % kReplayWindow] =
+          false;  // slide: clear the new slots
+    }
+    highest_ = ctr;
+  }
+  seen_[ctr % kReplayWindow] = true;
+}
+
+// ---- H.264
+// --------------------------------------------------------------------------------------------------------
+
+std::optional<size_t> H264SliceClearPrefixLength(std::span<const uint8_t> nal) {
+  if (nal.size() < 2) {
+    return std::nullopt;
+  }
+  // Unescape up to 32 RBSP bytes after the NAL header; end_pos[i] = index in
+  // `nal` just past RBSP byte i.
+  constexpr size_t kMaxRbsp = 32;
+  std::array<uint8_t, kMaxRbsp> rbsp{};
+  std::array<size_t, kMaxRbsp> end_pos{};
+  size_t n = 0;
+  int zeros = 0;
+  for (size_t i = 1; i < nal.size() && n < kMaxRbsp; ++i) {
+    const uint8_t b = nal[i];
+    if (zeros >= 2 && b == 0x03) {
+      zeros = 0;  // emulation prevention byte
+      continue;
+    }
+    rbsp[n] = b;
+    end_pos[n] = i + 1;
+    ++n;
+    zeros = (b == 0) ? zeros + 1 : 0;
+  }
+  BitstreamReader reader(std::span<const uint8_t>(rbsp.data(), n));
+  reader.ReadExponentialGolomb();  // first_mb_in_slice
+  reader.ReadExponentialGolomb();  // slice_type
+  reader.ReadExponentialGolomb();  // pic_parameter_set_id
+  if (!reader.Ok()) {
+    return std::nullopt;
+  }
+  const size_t bits = n * 8 - static_cast<size_t>(reader.RemainingBitCount());
+  const size_t bytes = (bits + 7) / 8;
+  if (bytes == 0 || bytes > n) {
+    return std::nullopt;
+  }
+  return end_pos[bytes - 1];
+}
+
+int TrailingZeros(std::span<const uint8_t> prefix) {
+  int z = 0;
+  for (size_t i = prefix.size(); i-- > 0 && z < 2;) {
+    if (prefix[i] != 0) {
+      break;
+    }
+    ++z;
+  }
+  return z;
+}
+
+void EscapeRegion(int leading_zeros,
+                  std::span<const uint8_t> in,
+                  std::vector<uint8_t>* out) {
+  int zeros = std::min(leading_zeros, 2);
+  const size_t start = out->size();
+  for (uint8_t b : in) {
+    if (zeros >= 2 && b <= 0x03) {
+      out->push_back(0x03);
+      zeros = 0;
+    }
+    out->push_back(b);
+    zeros = (b == 0) ? zeros + 1 : 0;
+  }
+  if (out->size() > start && (out->back() == 0x00 || out->back() == 0x03)) {
+    out->push_back(0x03);
+  }
+}
+
+std::optional<std::vector<uint8_t>> UnescapeRegion(
+    int leading_zeros,
+    std::span<const uint8_t> in) {
+  if (in.empty()) {
+    return std::vector<uint8_t>();
+  }
+  std::span<const uint8_t> body = in;
+  if (body.back() == 0x03) {
+    body = body.first(body.size() - 1);  // the final byte EscapeRegion appended
+  }
+  std::vector<uint8_t> out;
+  out.reserve(body.size());
+  int zeros = std::min(leading_zeros, 2);
+  for (uint8_t b : body) {
+    if (zeros >= 2 && b <= 0x03) {
+      if (b == 0x03) {
+        zeros = 0;  // emulation prevention byte
+        continue;
+      }
+      return std::nullopt;  // 00 00 00/01/02: a start code or forbidden
+                            // sequence, never EscapeRegion's output
+    }
+    out.push_back(b);
+    zeros = (b == 0) ? zeros + 1 : 0;
+  }
+  // Canonical form only: the input must be exactly what EscapeRegion produces
+  // for `out`.
+  std::vector<uint8_t> again;
+  again.reserve(in.size());
+  EscapeRegion(leading_zeros, out, &again);
+  if (again.size() != in.size() ||
+      !std::equal(again.begin(), again.end(), in.begin())) {
+    return std::nullopt;
+  }
+  return out;
+}
+
+}  // namespace sframe
+}  // namespace webrtc
diff --git a/api/crypto/sframe_core.h b/api/crypto/sframe_core.h
new file mode 100644
index 0000000..83313d4
--- /dev/null
+++ b/api/crypto/sframe_core.h
@@ -0,0 +1,221 @@
+/*
+ * Takamaka E2EE calls (C182 / DR-055) — RFC 9605 SFrame primitives, cipher
+ * suite 5 (AES_256_GCM_SHA512), on BoringSSL only. No key bytes are ever logged
+ * by this code.
+ *
+ * Spec: rschat-docs/security/E2EE_CALLS_PROTOCOL_SPEC_v1.md §9.2 (draft 0.2)
+ *   unit = clear codec prefix ‖ SFrame header ‖ ciphertext ‖ tag
+ *   AAD  = SFrame header ‖ clear prefix            (RFC 9605 §4.4.3: aad =
+ * header + metadata) KID  = the integer leg_index · 2^16 + (epoch mod 2^16),
+ * RFC 9605 §4.3 minimal encoding CTR  = per-key counter from 0; nonce = salt
+ * XOR BE96(CTR)
+ *
+ * The references this file must match byte for byte: the Java reference
+ * (Messages io.takamaka.messages.call.sframe.*) and the web worker
+ * (chat-web-gui static/js/call/sframe-core.js), through the vectors
+ * group6_sframe of security/vectors/call_vectors_v1.json.
+ */
+
+#ifndef API_CRYPTO_SFRAME_CORE_H_
+#define API_CRYPTO_SFRAME_CORE_H_
+
+#include <array>
+#include <bitset>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <span>
+#include <vector>
+
+#include "rtc_base/system/rtc_export.h"
+
+namespace webrtc {
+namespace sframe {
+
+inline constexpr uint16_t kCipherSuite =
+    0x0005;                                // AES_256_GCM_SHA512 (RFC 9605 §8.1)
+inline constexpr size_t kKeySize = 32;     // Nk
+inline constexpr size_t kNonceSize = 12;   // Nn
+inline constexpr size_t kTagSize = 16;     // Nt (full tag)
+inline constexpr size_t kSecretSize = 64;  // SHA-512 output
+inline constexpr size_t kBaseKeySize =
+    32;  // spec §6.1: sender_base_e is 32 bytes
+inline constexpr size_t kMaxHeaderSize = 1 + 8 + 8;
+// CTR values at or above this need a new epoch. Same limit as the web worker
+// (6-byte CTR field, JS safe integers); unreachable in practice (2^48 frames).
+inline constexpr uint64_t kCtrLimit = uint64_t{1} << 48;
+inline constexpr size_t kReplayWindow =
+    128;  // spec §9.2: 128 frames on CTR, per sender key
+
+// ---- KID convention (spec §9.2)
+// ---------------------------------------------------------------------------------
+
+// KID = leg_index · 2^16 + (epoch mod 2^16). leg_index is 16-bit; leg_index 0
+// is reserved (never assigned: the relay's blank VP8 frame parses as KID 0).
+// Returns nullopt when leg_index does not fit 16 bits.
+RTC_EXPORT std::optional<uint64_t> MakeKid(uint32_t leg_index, uint64_t epoch);
+inline uint32_t LegIndexOf(uint64_t kid) {
+  return static_cast<uint32_t>(kid >> 16);
+}
+inline uint32_t EpochOf(uint64_t kid) {
+  return static_cast<uint32_t>(kid & 0xFFFF);
+}
+// A KID this implementation accepts for a key: leg_index 1..65535 (so 2^16 <=
+// kid < 2^32).
+inline bool IsAssignableKid(uint64_t kid) {
+  return kid >= (uint64_t{1} << 16) && kid < (uint64_t{1} << 32);
+}
+
+// ---- header (RFC 9605 §4.3)
+// -------------------------------------------------------------------------------------
+//   config byte X(1) K(3) Y(1) C(3); values 0..7 inline, otherwise the MINIMUM
+//   number of big-endian bytes.
+
+struct Header {
+  uint64_t kid = 0;
+  uint64_t ctr = 0;
+  size_t length = 0;  // header bytes
+};
+
+RTC_EXPORT std::vector<uint8_t> EncodeHeader(uint64_t kid, uint64_t ctr);
+// Parses a header at the start of `data`. nullopt on truncation or on a
+// non-minimal encoding (a decoder MUST reject those, RFC 9605 §4.3 / spec
+// §9.2).
+RTC_EXPORT std::optional<Header> ParseHeader(std::span<const uint8_t> data);
+
+// ---- key schedule (RFC 9605 §4.4.2)
+// -----------------------------------------------------------------------------
+//   sframe_secret = HKDF-Extract("", base_key) (SHA-512) sframe_key    =
+//   HKDF-Expand(secret, "SFrame 1.0 Secret key "  ‖ BE64(KID) ‖ BE16(suite),
+//   32) sframe_salt   = HKDF-Expand(secret, "SFrame 1.0 Secret salt " ‖
+//   BE64(KID) ‖ BE16(suite), 12)
+
+struct KeyMaterial {
+  std::array<uint8_t, kKeySize> key{};
+  std::array<uint8_t, kNonceSize> salt{};
+  ~KeyMaterial();  // wipes
+};
+
+RTC_EXPORT std::vector<uint8_t> KeyLabel(uint64_t kid);
+RTC_EXPORT std::vector<uint8_t> SaltLabel(uint64_t kid);
+// Any base key length is accepted here (the RFC vector uses 16 bytes); the key
+// store enforces kBaseKeySize. `secret_out` (optional) receives sframe_secret —
+// for the vectors only.
+RTC_EXPORT bool DeriveKeyMaterial(
+    uint64_t kid,
+    std::span<const uint8_t> base_key,
+    KeyMaterial* out,
+    std::array<uint8_t, kSecretSize>* secret_out = nullptr);
+
+RTC_EXPORT std::array<uint8_t, kNonceSize> MakeNonce(
+    std::span<const uint8_t, kNonceSize> salt,
+    uint64_t ctr);
+
+// ---- AEAD (RFC 9605 §4.4.3, §4.4.4)
+// -----------------------------------------------------------------------------
+
+// One initialised AES-256-GCM context for one (KID, key, salt). Not copyable.
+class RTC_EXPORT SealingKey {
+ public:
+  // nullptr on a BoringSSL failure.
+  static std::unique_ptr<SealingKey> Create(uint64_t kid,
+                                            const KeyMaterial& material);
+  ~SealingKey();
+  SealingKey(const SealingKey&) = delete;
+  SealingKey& operator=(const SealingKey&) = delete;
+
+  uint64_t kid() const { return kid_; }
+  // Constant-time comparison with other key material (no-op detection of
+  // SetKey).
+  bool SameMaterial(const KeyMaterial& other) const;
+
+  // Appends ciphertext ‖ tag of `plaintext` to `out`. AAD = header ‖ metadata.
+  bool Seal(uint64_t ctr,
+            std::span<const uint8_t> header,
+            std::span<const uint8_t> metadata,
+            std::span<const uint8_t> plaintext,
+            std::vector<uint8_t>* out) const;
+  // Appends the plaintext of `ct_and_tag` to `out`; false on a bad tag (out
+  // unchanged).
+  bool Open(uint64_t ctr,
+            std::span<const uint8_t> header,
+            std::span<const uint8_t> metadata,
+            std::span<const uint8_t> ct_and_tag,
+            std::vector<uint8_t>* out) const;
+
+ private:
+  SealingKey();
+  struct Impl;
+  uint64_t kid_ = 0;
+  std::array<uint8_t, kKeySize> key_{};
+  std::array<uint8_t, kNonceSize> salt_{};
+  std::unique_ptr<Impl> impl_;
+};
+
+// RFC form: header ‖ AEAD(key, nonce, header ‖ metadata, plaintext).
+RTC_EXPORT std::vector<uint8_t> Encrypt(const SealingKey& key,
+                                        uint64_t ctr,
+                                        std::span<const uint8_t> metadata,
+                                        std::span<const uint8_t> plaintext);
+// RFC form decryption; nullopt on a header error, a KID that is not the key's,
+// or a bad tag.
+RTC_EXPORT std::optional<std::vector<uint8_t>> Decrypt(
+    const SealingKey& key,
+    std::span<const uint8_t> metadata,
+    std::span<const uint8_t> sframe_ciphertext);
+
+// ---- replay window (spec §9.2: 128 frames on CTR, per sender key)
+// ------------------------------------------------
+//   Check() before decrypting; Commit() only after the tag verified, so forged
+//   frames cannot move the window.
+
+class RTC_EXPORT ReplayWindow {
+ public:
+  enum class Verdict { kOk, kReplay, kTooOld };
+  Verdict Check(uint64_t ctr) const;
+  void Commit(uint64_t ctr);
+
+ private:
+  bool any_ = false;
+  uint64_t highest_ = 0;
+  std::bitset<kReplayWindow> seen_;
+};
+
+// ---- H.264 (spec §9.2 [0.2] fallback rule)
+// -----------------------------------------------------------------------
+//   SPS/PPS/SEI/AUD in clear; each slice NAL unit (types 1 and 5) = its own
+//   SFrame unit behind a clear prefix = the 1-byte NAL header + the
+//   slice-header bytes up to and including pic_parameter_set_id; consecutive
+//   CTR values within a frame; everything after the clear prefix (SFrame header
+//   ‖ ciphertext ‖ tag) emulation-prevention escaped. See EscapeRegion for the
+//   exact escaping rule (proposed for the spec, OPEN H-2 of the M1 report).
+
+// Length, in bytes of `nal` (escaped form, NAL header included), of the clear
+// prefix of a slice NAL; nullopt if the three ue(v) fields cannot be read.
+RTC_EXPORT std::optional<size_t> H264SliceClearPrefixLength(
+    std::span<const uint8_t> nal);
+
+// Number of trailing 0x00 bytes of `prefix`, capped at 2: the escaping context
+// of the region that follows it.
+RTC_EXPORT int TrailingZeros(std::span<const uint8_t> prefix);
+
+// Emulation-prevention escaping of `in`, appended to `out`, as if `in` followed
+// `leading_zeros` zero bytes: 0x03 is inserted after two zeros when the next
+// byte is <= 0x03; then, if the escaped region is non-empty and ends in 0x00 or
+// 0x03, one final 0x03 is appended. The final byte makes the rule reversible
+// and keeps a NAL unit from ending in 0x00 (which an Annex-B reader would take
+// as part of the next start code).
+RTC_EXPORT void EscapeRegion(int leading_zeros,
+                             std::span<const uint8_t> in,
+                             std::vector<uint8_t>* out);
+// Inverse of EscapeRegion. nullopt on input that EscapeRegion cannot produce (a
+// forbidden 00 00 0x sequence).
+RTC_EXPORT std::optional<std::vector<uint8_t>> UnescapeRegion(
+    int leading_zeros,
+    std::span<const uint8_t> in);
+
+}  // namespace sframe
+}  // namespace webrtc
+
+#endif  // API_CRYPTO_SFRAME_CORE_H_
diff --git a/api/crypto/sframe_core_unittest.cc b/api/crypto/sframe_core_unittest.cc
new file mode 100644
index 0000000..43688de
--- /dev/null
+++ b/api/crypto/sframe_core_unittest.cc
@@ -0,0 +1,317 @@
+/*
+ * C182 / DR-055 — RFC 9605 SFrame primitives against the RFC vectors and our
+ * Java reference vectors (group6_sframe of
+ * rschat-docs/security/vectors/call_vectors_v1.json), byte for byte.
+ */
+
+#include "api/crypto/sframe_core.h"
+
+#include <random>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "test/gtest.h"
+
+namespace webrtc {
+namespace sframe {
+namespace {
+
+#include "api/crypto/sframe_test_vectors.inc"
+
+std::vector<uint8_t> Unhex(const std::string& s) {
+  std::vector<uint8_t> out;
+  for (size_t i = 0; i + 1 < s.size(); i += 2) {
+    out.push_back(static_cast<uint8_t>(std::stoi(s.substr(i, 2), nullptr, 16)));
+  }
+  return out;
+}
+
+std::string Hex(std::span<const uint8_t> b) {
+  static constexpr std::string_view d = "0123456789abcdef";
+  std::string s;
+  for (uint8_t x : b) {
+    s += d[x >> 4];
+    s += d[x & 15];
+  }
+  return s;
+}
+
+std::vector<uint8_t> Cat(std::span<const uint8_t> a,
+                         std::span<const uint8_t> b) {
+  std::vector<uint8_t> out(a.begin(), a.end());
+  out.insert(out.end(), b.begin(), b.end());
+  return out;
+}
+
+// ---- RFC 9605 Appendix C.1: all 289 header encodings
+// ----------------------------------------------------------
+
+TEST(SframeCore, Rfc9605AppendixC1Headers) {
+  ASSERT_EQ(std::size(kRfc9605C1), 289u);
+  for (const C1Row& row : kRfc9605C1) {
+    EXPECT_EQ(Hex(EncodeHeader(row.kid, row.ctr)), row.header) << row.header;
+    const std::vector<uint8_t> h = Unhex(row.header);
+    std::optional<Header> d = ParseHeader(h);
+    ASSERT_TRUE(d) << row.header;
+    EXPECT_EQ(d->kid, row.kid);
+    EXPECT_EQ(d->ctr, row.ctr);
+    EXPECT_EQ(d->length, h.size());
+    // Every strict prefix is a truncation and must fail.
+    for (size_t n = 0; n < h.size(); ++n) {
+      EXPECT_FALSE(ParseHeader(std::span<const uint8_t>(h).first(n)))
+          << row.header << " truncated to " << n;
+    }
+  }
+}
+
+TEST(SframeCore, NonMinimalHeadersRejected) {
+  // The Java reference's negative cases (SframeTest.nonMinimalHeadersRejected)
+  // ...
+  EXPECT_FALSE(ParseHeader(Unhex("8005")));    // KID 5 in an extension byte
+  EXPECT_FALSE(ParseHeader(Unhex("090001")));  // CTR 1 in 2 bytes
+  EXPECT_FALSE(ParseHeader(Unhex("90000a")));  // KID 10 in 2 bytes
+  EXPECT_FALSE(ParseHeader(Unhex("a001")));    // truncated
+  // ... and a few more: a leading zero byte in a long field, CTR 7 extended.
+  EXPECT_FALSE(ParseHeader(Unhex("a000ffff")));
+  EXPECT_FALSE(ParseHeader(Unhex("0807")));
+  EXPECT_TRUE(ParseHeader(Unhex("0808")));
+}
+
+TEST(SframeCore, Rfc9605AppendixC3Suite5) {
+  const C3Suite5& v = kRfc9605C3Suite5;
+  EXPECT_EQ(Hex(KeyLabel(v.kid)), v.key_label);
+  EXPECT_EQ(Hex(SaltLabel(v.kid)), v.salt_label);
+  KeyMaterial m;
+  std::array<uint8_t, kSecretSize> secret{};
+  ASSERT_TRUE(DeriveKeyMaterial(v.kid, Unhex(v.base_key), &m, &secret));
+  EXPECT_EQ(Hex(secret), v.secret);
+  EXPECT_EQ(Hex(m.key), v.key);
+  EXPECT_EQ(Hex(m.salt), v.salt);
+  EXPECT_EQ(Hex(MakeNonce(std::span<const uint8_t, kNonceSize>(m.salt), v.ctr)),
+            v.nonce);
+  std::unique_ptr<SealingKey> k = SealingKey::Create(v.kid, m);
+  ASSERT_TRUE(k);
+  EXPECT_EQ(Hex(Encrypt(*k, v.ctr, Unhex(v.metadata), Unhex(v.pt))), v.ct);
+  std::optional<std::vector<uint8_t>> pt =
+      Decrypt(*k, Unhex(v.metadata), Unhex(v.ct));
+  ASSERT_TRUE(pt);
+  EXPECT_EQ(Hex(*pt), v.pt);
+  // The metadata is authenticated: without it the tag fails (Java: assertThrows
+  // on empty metadata).
+  EXPECT_FALSE(Decrypt(*k, {}, Unhex(v.ct)));
+}
+
+// ---- our units (Java reference, group6_sframe.units)
+// -----------------------------------------------------------
+
+TEST(SframeCore, OurKidMapping) {
+  EXPECT_EQ(MakeKid(kUnitsLegIndex, kUnitsEpoch), kUnitsKid);
+  EXPECT_EQ(MakeKid(1, 4), 0x00010004u);
+  EXPECT_EQ(MakeKid(1, 65536), 0x00010000u);  // epoch taken mod 2^16
+  EXPECT_EQ(MakeKid(0, 3), 3u);
+  EXPECT_EQ(Hex(EncodeHeader(*MakeKid(0, 3), 0)),
+            "30");  // leg 0, epoch 3: inline (why leg 0 is reserved)
+  EXPECT_EQ(Hex(EncodeHeader(*MakeKid(1, 4), 0)), "a0010004");
+  EXPECT_EQ(Hex(EncodeHeader(*MakeKid(0xffff, 0xffff), 0)), "b0ffffffff");
+  EXPECT_FALSE(MakeKid(0x10000, 0));
+  EXPECT_FALSE(IsAssignableKid(3));
+  EXPECT_FALSE(IsAssignableKid(0xffff));
+  EXPECT_TRUE(IsAssignableKid(0x10000));
+  EXPECT_TRUE(IsAssignableKid(0xffffffff));
+  EXPECT_FALSE(IsAssignableKid(0x100000000));
+  EXPECT_EQ(LegIndexOf(kUnitsKid), kUnitsLegIndex);
+  EXPECT_EQ(EpochOf(kUnitsKid), kUnitsEpoch);
+}
+
+TEST(SframeCore, JavaReferenceUnits) {
+  KeyMaterial m;
+  std::array<uint8_t, kSecretSize> secret{};
+  ASSERT_TRUE(DeriveKeyMaterial(kUnitsKid, Unhex(kUnitsBaseKey), &m, &secret));
+  EXPECT_EQ(Hex(secret), kUnitsSecret);
+  EXPECT_EQ(Hex(m.key), kUnitsKey);
+  EXPECT_EQ(Hex(m.salt), kUnitsSalt);
+  std::unique_ptr<SealingKey> k = SealingKey::Create(kUnitsKid, m);
+  ASSERT_TRUE(k);
+  ASSERT_EQ(std::size(kUnitCases), 4u);
+  for (const UnitCase& c : kUnitCases) {
+    const std::vector<uint8_t> frame = Unhex(c.frame);
+    const std::span<const uint8_t> prefix =
+        std::span<const uint8_t>(frame).first(c.prefix_len);
+    const std::vector<uint8_t> header = EncodeHeader(kUnitsKid, c.ctr);
+    EXPECT_EQ(Hex(header), c.header) << c.codec << " ctr " << c.ctr;
+    EXPECT_EQ(
+        Hex(MakeNonce(std::span<const uint8_t, kNonceSize>(m.salt), c.ctr)),
+        c.nonce);
+    EXPECT_EQ(Hex(Cat(header, prefix)), c.aad);
+    // unit = prefix ‖ header ‖ ct ‖ tag, AAD = header ‖ prefix
+    std::vector<uint8_t> unit(prefix.begin(), prefix.end());
+    unit.insert(unit.end(), header.begin(), header.end());
+    ASSERT_TRUE(k->Seal(c.ctr, header, prefix,
+                        std::span<const uint8_t>(frame).subspan(c.prefix_len),
+                        &unit));
+    EXPECT_EQ(Hex(unit), c.unit) << c.codec << " ctr " << c.ctr;
+    // and back
+    const std::vector<uint8_t> expected = Unhex(c.unit);
+    std::optional<Header> h =
+        ParseHeader(std::span<const uint8_t>(expected).subspan(c.prefix_len));
+    ASSERT_TRUE(h);
+    std::vector<uint8_t> opened(prefix.begin(), prefix.end());
+    ASSERT_TRUE(k->Open(
+        h->ctr,
+        std::span<const uint8_t>(expected).subspan(c.prefix_len, h->length),
+        prefix,
+        std::span<const uint8_t>(expected).subspan(c.prefix_len + h->length),
+        &opened));
+    EXPECT_EQ(Hex(opened), c.frame);
+  }
+}
+
+TEST(SframeCore, WrongKeyOrKidNeverOpens) {
+  const std::vector<uint8_t> base = Unhex(kUnitsBaseKey);
+  KeyMaterial right, other_kid, other_key;
+  ASSERT_TRUE(DeriveKeyMaterial(kUnitsKid, base, &right));
+  ASSERT_TRUE(
+      DeriveKeyMaterial(kUnitsKid + 1, base, &other_kid));  // another epoch
+  std::vector<uint8_t> base2 = base;
+  base2[0] ^= 1;
+  ASSERT_TRUE(DeriveKeyMaterial(kUnitsKid, base2,
+                                &other_key));  // same KID, another base key
+  auto k = SealingKey::Create(kUnitsKid, right);
+  auto k2 = SealingKey::Create(kUnitsKid + 1, other_kid);
+  auto k3 = SealingKey::Create(kUnitsKid, other_key);
+  const std::vector<uint8_t> meta = {0x78};
+  const std::vector<uint8_t> pt = Unhex(kUnitCases[0].frame);
+  const std::vector<uint8_t> ct = Encrypt(*k, 9, meta, pt);
+  EXPECT_TRUE(Decrypt(*k, meta, ct));
+  EXPECT_FALSE(Decrypt(*k2, meta, ct));  // KID mismatch
+  EXPECT_FALSE(Decrypt(*k3, meta, ct));  // bad tag
+  std::vector<uint8_t> t = ct;
+  t.back() ^= 1;
+  EXPECT_FALSE(Decrypt(*k, meta, t));
+  EXPECT_FALSE(Decrypt(*k, std::vector<uint8_t>{0x79},
+                       ct));  // the clear prefix is authenticated
+}
+
+// ---- replay window
+// ----------------------------------------------------------------------------------------------
+
+TEST(SframeCore, ReplayWindow128) {
+  ReplayWindow w;
+  EXPECT_EQ(w.Check(0), ReplayWindow::Verdict::kOk);
+  w.Commit(0);
+  EXPECT_EQ(w.Check(0), ReplayWindow::Verdict::kReplay);
+  w.Commit(200);
+  EXPECT_EQ(w.Check(200), ReplayWindow::Verdict::kReplay);
+  EXPECT_EQ(w.Check(73),
+            ReplayWindow::Verdict::kOk);  // 200 - 73 = 127: inside, late,
+                                          // accepted once
+  w.Commit(73);
+  EXPECT_EQ(w.Check(73), ReplayWindow::Verdict::kReplay);
+  EXPECT_EQ(w.Check(72),
+            ReplayWindow::Verdict::kTooOld);  // 200 - 72 = 128: outside
+  EXPECT_EQ(w.Check(0), ReplayWindow::Verdict::kTooOld);
+  EXPECT_EQ(w.Check(201), ReplayWindow::Verdict::kOk);
+  // Sliding clears stale slots: 201 shares the slot of 73 (201 % 128), cleared
+  // when the window moved past it.
+  w.Commit(300);
+  EXPECT_EQ(w.Check(201), ReplayWindow::Verdict::kOk);
+  EXPECT_EQ(w.Check(200), ReplayWindow::Verdict::kReplay);  // 100 behind, seen
+  EXPECT_EQ(w.Check(173), ReplayWindow::Verdict::kOk);  // 127 behind, unseen
+  EXPECT_EQ(w.Check(172), ReplayWindow::Verdict::kTooOld);  // 128 behind
+  EXPECT_EQ(w.Check(300), ReplayWindow::Verdict::kReplay);
+  // Check() alone never moves the window (a forged frame cannot).
+  ReplayWindow f;
+  f.Commit(10);
+  EXPECT_EQ(f.Check(1000), ReplayWindow::Verdict::kOk);
+  EXPECT_EQ(f.Check(10), ReplayWindow::Verdict::kReplay);
+  EXPECT_EQ(f.Check(9), ReplayWindow::Verdict::kOk);
+}
+
+// ---- H.264 helpers
+// ----------------------------------------------------------------------------------------------
+
+bool HasForbidden(std::span<const uint8_t> b, int leading_zeros) {
+  int zeros = leading_zeros;
+  for (uint8_t x : b) {
+    if (zeros >= 2 && x <= 0x02) {
+      return true;
+    }
+    zeros = (x == 0) ? zeros + 1 : 0;
+  }
+  return false;
+}
+
+TEST(SframeCore, EscapeRegionRoundTripAndNoStartCodes) {
+  std::mt19937 rng(182);
+  for (int lead = 0; lead <= 2; ++lead) {
+    for (int iter = 0; iter < 4000; ++iter) {
+      // Biased toward zeros and small bytes, where the escaping rules bite.
+      const size_t n = 1 + rng() % 40;
+      std::vector<uint8_t> in(n);
+      for (auto& b : in) {
+        const uint32_t r = rng() % 8;
+        b = r < 4 ? 0
+                  : (r < 7 ? static_cast<uint8_t>(rng() % 4)
+                           : static_cast<uint8_t>(rng()));
+      }
+      std::vector<uint8_t> esc;
+      EscapeRegion(lead, in, &esc);
+      ASSERT_FALSE(HasForbidden(esc, lead)) << Hex(in) << " lead " << lead;
+      ASSERT_NE(esc.back(), 0x00) << Hex(in);
+      std::optional<std::vector<uint8_t>> back = UnescapeRegion(lead, esc);
+      ASSERT_TRUE(back) << Hex(in) << " -> " << Hex(esc);
+      ASSERT_EQ(*back, in) << Hex(esc);
+    }
+  }
+}
+
+TEST(SframeCore, EscapeRegionKnownCases) {
+  auto esc = [](int lead, const std::string& h) {
+    std::vector<uint8_t> o;
+    EscapeRegion(lead, Unhex(h), &o);
+    return Hex(o);
+  };
+  EXPECT_EQ(esc(0, "0000010203"),
+            "00000301020303");  // 00 00 01 → 00 00 03 01; final 03 → + 03
+  EXPECT_EQ(esc(0, "000004"), "000004");    // 04 after 00 00 needs nothing
+  EXPECT_EQ(esc(0, "aa00"), "aa0003");      // never ends in 00
+  EXPECT_EQ(esc(0, "aa0000"), "aa000003");  // the H.264 cabac_zero_word shape
+  EXPECT_EQ(esc(2, "01ff"), "0301ff");  // context: the prefix ended in 00 00
+  EXPECT_EQ(esc(1, "0001"), "000301");
+  EXPECT_EQ(esc(0, "ff03"), "ff0303");
+  // Non-canonical / forbidden inputs are rejected.
+  EXPECT_FALSE(UnescapeRegion(0, Unhex("000001")));
+  EXPECT_FALSE(UnescapeRegion(2, Unhex("01ff")));
+  EXPECT_FALSE(
+      UnescapeRegion(0, Unhex("ff00")));  // a valid escaping never ends in 00
+  EXPECT_FALSE(
+      UnescapeRegion(0, Unhex("0000030503")));  // a superfluous emulation byte
+}
+
+TEST(SframeCore, H264SliceClearPrefix) {
+  // LiveKit's blank IDR (65 88 84 …): first_mb 0 ('1'), slice_type 7
+  // ('0001000'), pps 0 ('1') → 9 bits → 2 bytes.
+  EXPECT_EQ(H264SliceClearPrefixLength(Unhex("6588840af2628000a7be")), 3u);
+  // P slice, first_mb 5 ('00110'), slice_type 5 ('00110'), pps 0 ('1') = 0011
+  // 0001 1010 0000 → 2 bytes.
+  EXPECT_EQ(H264SliceClearPrefixLength(Unhex("4131a0ffff")), 3u);
+  // A huge first_mb_in_slice whose RBSP holds 00 00 01: the escaped prefix
+  // counts the emulation byte. RBSP 00 00 01 00 00 01 c0: 23 zeros, then 1, 23
+  // info bits (first_mb = 2^23 - 1), slice_type 1, pps 1 → 49 bits
+  EXPECT_EQ(H264SliceClearPrefixLength(Unhex("45"
+                                             "0000030100000301"
+                                             "c0"
+                                             "ab")),
+            10u);
+  EXPECT_FALSE(H264SliceClearPrefixLength(Unhex("65")));
+  EXPECT_FALSE(
+      H264SliceClearPrefixLength(Unhex("650000")));  // ue(v) never terminates
+  EXPECT_EQ(TrailingZeros(Unhex("650000")), 2);
+  EXPECT_EQ(TrailingZeros(Unhex("6500")), 1);
+  EXPECT_EQ(TrailingZeros(Unhex("65")), 0);
+}
+
+}  // namespace
+}  // namespace sframe
+}  // namespace webrtc
diff --git a/api/crypto/sframe_gen_test_vectors.py b/api/crypto/sframe_gen_test_vectors.py
new file mode 100644
index 0000000..8132061
--- /dev/null
+++ b/api/crypto/sframe_gen_test_vectors.py
@@ -0,0 +1,41 @@
+import json, sys
+c1, vec, out = sys.argv[1], sys.argv[2], sys.argv[3]
+rows = []
+for line in open(c1):
+    line = line.strip()
+    if not line or line.startswith('#'):
+        continue
+    k, c, h = line.split()
+    rows.append((k, c, h))
+d = json.load(open(vec))['group6_sframe']
+r = d['rfc9605_c3_suite5']
+u = d['units']
+L = []
+L.append('// GENERATED by gen_vectors.py from')
+L.append('//   Messages/src/test/resources/call/rfc9605_c1_headers.txt (RFC 9605 Appendix C.1, %d rows) and' % len(rows))
+L.append('//   rschat-docs/security/vectors/call_vectors_v1.json group6_sframe (Java reference generator).')
+L.append('// Do not edit by hand.')
+L.append('struct C1Row { uint64_t kid; uint64_t ctr; const char* header; };')
+L.append('constexpr C1Row kRfc9605C1[] = {')
+for k, c, h in rows:
+    L.append('    {0x%sULL, 0x%sULL, "%s"},' % (k, c, h))
+L.append('};')
+L.append('struct C3Suite5 { uint64_t kid; uint64_t ctr; const char* base_key; const char* key_label; const char* salt_label;')
+L.append('  const char* secret; const char* key; const char* salt; const char* metadata; const char* nonce; const char* pt; const char* ct; };')
+L.append('constexpr C3Suite5 kRfc9605C3Suite5 = {0x%sULL, 0x%sULL, "%s", "%s", "%s", "%s", "%s", "%s", "%s", "%s", "%s", "%s"};' % (
+    r['kid'], r['ctr'], r['base_key'], r['sframe_key_label'], r['sframe_salt_label'], r['sframe_secret'], r['sframe_key'],
+    r['sframe_salt'], r['metadata'], r['nonce'], r['pt'], r['ct']))
+L.append('struct UnitCase { const char* codec; size_t prefix_len; uint64_t ctr; const char* frame; const char* header; const char* nonce; const char* aad; const char* unit; };')
+L.append('constexpr uint32_t kUnitsLegIndex = %d;' % u['leg_index'])
